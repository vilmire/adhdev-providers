/ide/cursor/                   @vilmire
/ide/kiro/                     @vilmire
/ide/pearai/                   @vilmire
/ide/trae/                     @vilmire
/ide/vscode/                   @vilmire
/ide/vscodium/                 @vilmire
/ide/windsurf/                 @vilmire

# Extension providers
/extension/claude-code-vscode/ @vilmire
/extension/cline/              @vilmire
