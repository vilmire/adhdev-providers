{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "middle"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  },
  "required": [
    "x",
    "y"
  ],
  "additionalProperties": false
}
