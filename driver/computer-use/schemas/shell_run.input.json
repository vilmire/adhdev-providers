{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false
}
