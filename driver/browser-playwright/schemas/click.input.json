{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "element": {
      "type": "string",
      "maxLength": 4096
    },
    "target": {
      "type": "string",
      "maxLength": 4096
    },
    "doubleClick": {
      "type": "boolean"
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "middle"
      ]
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Alt",
          "Control",
          "ControlOrMeta",
          "Meta",
          "Shift"
        ]
      },
      "maxItems": 64
    }
  },
  "required": [
    "target"
  ],
  "additionalProperties": false
}
