{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string",
            "maxLength": 4096
          },
          "target": {
            "type": "string",
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "type": {
            "type": "string",
            "enum": [
              "textbox",
              "checkbox",
              "radio",
              "combobox",
              "slider"
            ]
          },
          "value": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "target",
          "name",
          "type",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": false
}
