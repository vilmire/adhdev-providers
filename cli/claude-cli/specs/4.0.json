{
  "$schema": "adhdev:cli/spec@4",
  "id": "claude-cli",
  "name": "Claude Code",
  "binary": "claude",
  "cli_version_range": ">=2.1.0",
  "spawn_args": [
    "--permission-mode",
    "default"
  ],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "sections": {
    "footer": {
      "anchor": "^(?:[❯›>]|[│|]\\s*[❯›>])",
      "anchor_last": true
    },
    "modal": {
      "anchor": [
        "^[─╌]+$",
        "\\S"
      ],
      "anchor_last": true,
      "anchor_context": [
        {
          "next": "^(?![─╌]+$)"
        },
        {
          "next": "^\\s*[❯›➜]?\\s*1\\.\\s"
        }
      ],
      "until": "^\\s*(?:[❯›➜]|>(?=\\s|$))(?!\\s*\\d+\\.)"
    },
    "body": {
      "from_top": 0,
      "until": "modal"
    },
    "status_tail": {
      "from_bottom": 12
    }
  },
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2,
          "select_mode": "arrow_keys"
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "modal": true,
      "modal_kind": "picker",
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "key_for_index": "{index}\r"
        }
      }
    },
    {
      "id": "approval_resolving",
      "label": "Approval resolving",
      "status": "approval"
    },
    {
      "id": "approval_vanished",
      "label": "Approval clearing",
      "status": "approval"
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "elapsed_ms": 8000
      }
    },
    {
      "label": "→approval",
      "from": [
        "starting",
        "idle",
        "busy",
        "approval_resolving"
      ],
      "to": "approval",
      "priority": 100,
      "when": {
        "all": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
          },
          {
            "section": "footer",
            "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|Do you want"
          },
          {
            "not": {
              "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
            }
          },
          {
            "any": [
              {
                "section": "footer",
                "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S[\\s\\S]*?(?:^|\\n)\\s*(?:[❯›]\\s*)?2\\.\\s+\\S"
              },
              {
                "not": {
                  "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "label": "→picker",
      "from": [
        "starting",
        "idle",
        "busy",
        "approval_resolving"
      ],
      "to": "picker",
      "priority": 110,
      "when": {
        "any": [
          {
            "all": [
              {
                "section": "modal",
                "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
              },
              {
                "not": {
                  "section": "modal",
                  "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|don't ask again\\b"
                }
              }
            ]
          },
          {
            "all": [
              {
                "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
              },
              {
                "section": "footer",
                "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "idle→busy",
      "from": [
        "idle",
        "starting"
      ],
      "to": "busy",
      "min_hold_ms": 1000,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "section": "body",
            "matches": "✻\\s+\\w[^\\n]*?\\bfor\\s+\\d+[smh](?:\\s+\\d+[smh])*(?![^\\n]*\\btokens?\\b)(?![^\\n]*[↑↓])[^\\n]*(?:\\n(?![^\\n]*(?:[✢✳✶✽✷✸✹⠀-⣿]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.)|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))[^\\n]*)*$"
          },
          {
            "stable_ms": 8000,
            "ignore_lines": "^\\s*✻\\s+\\w(?:(?!\\bfor\\s+\\d)[^\\n])*$|^\\s*[↑↓]\\s*[\\d.]+[km]?\\s*tokens?[^\\n]*$"
          }
        ]
      }
    },
    {
      "label": "busy→idle-quiet",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "not": {
              "matches": "[↑↓]\\s*[\\d.]+[km]?\\s*tokens?"
            }
          },
          {
            "stable_ms": 12000,
            "ignore_lines": "^\\s*✻\\s+\\w(?:(?!\\bfor\\s+\\d)[^\\n])*$|^\\s*[↑↓]\\s*[\\d.]+[km]?\\s*tokens?[^\\n]*$"
          }
        ]
      }
    },
    {
      "label": "approval→resolving",
      "from": "approval",
      "to": "approval_resolving",
      "min_hold_ms": 2500,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|during this session\\b|don't ask again\\b"
            }
          },
          {
            "not": {
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
            }
          },
          {
            "not": {
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S[\\s\\S]*?(?:^|\\n)\\s*(?:[❯›]\\s*)?2\\.\\s+\\S"
            }
          },
          {
            "section": "status_tail",
            "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
          }
        ]
      }
    },
    {
      "label": "approval-resolving→approval-no-spinner",
      "from": "approval_resolving",
      "to": "approval",
      "priority": 50,
      "when": {
        "not": {
          "section": "status_tail",
          "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
        }
      }
    },
    {
      "label": "approval-resolving→busy",
      "from": "approval_resolving",
      "to": "busy",
      "min_hold_ms": 1200,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "approval→idle",
      "from": [
        "approval",
        "picker"
      ],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "stable_ms": 3000,
            "cursor_above": 5
          }
        ]
      }
    },
    {
      "label": "approval→vanished",
      "from": [
        "approval",
        "picker"
      ],
      "to": "approval_vanished",
      "priority": 90,
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b"
            }
          },
          {
            "not": {
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S[\\s\\S]*?(?:^|\\n)\\s*(?:[❯›]\\s*)?2\\.\\s+\\S"
            }
          },
          {
            "not": {
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
            }
          },
          {
            "not": {
              "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          }
        ]
      }
    },
    {
      "label": "vanished→approval-modal-returned",
      "from": "approval_vanished",
      "to": "approval",
      "priority": 120,
      "when": {
        "any": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
          },
          {
            "section": "footer",
            "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b"
          },
          {
            "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S[\\s\\S]*?(?:^|\\n)\\s*(?:[❯›]\\s*)?2\\.\\s+\\S"
          },
          {
            "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
          }
        ]
      }
    },
    {
      "label": "vanished→busy",
      "from": "approval_vanished",
      "to": "busy",
      "priority": 100,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "vanished→idle",
      "from": "approval_vanished",
      "to": "idle",
      "priority": 10,
      "when": {
        "elapsed_ms": 1200
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select (?:a |an )?model"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r",
        "select_mode": "arrow_keys"
      }
    },
    {
      "id": "cycle_mode",
      "label": "Mode",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b[Z"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Claude Code",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.claude/projects/{cwd_claude_project}/{session_id}.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": {
        "where": "$.type == 'user' || $.type == 'assistant'"
      },
      "message_map": {
        "role": "$.message.role",
        "content": "$.message.content",
        "timestamp_ms": "$.timestamp",
        "tools": {}
      }
    }
  }
}
