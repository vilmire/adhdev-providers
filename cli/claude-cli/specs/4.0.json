{
  "$schema": "adhdev:cli/spec@4",
  "id": "claude-cli",
  "name": "Claude Code",
  "binary": "claude",
  "cli_version_range": ">=2.1.0",
  "spawn_args": [
    "--permission-mode",
    "default"
  ],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "sections": {
    "footer": {
      "anchor": "^[❯›>]",
      "anchor_last": true
    },
    "modal": {
      "anchor": [
        "^[─╌]+$",
        "\\S"
      ],
      "anchor_last": true,
      "anchor_context": [
        {
          "next": "^(?![─╌]+$)"
        },
        {
          "next": "^\\s*[❯›>➜]?\\s*1\\.\\s"
        }
      ],
      "until": "^\\s*[❯›>➜](?!\\s*\\d+\\.)"
    },
    "body": {
      "from_top": 0,
      "until": "modal"
    }
  },
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "modal": true,
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "key_for_index": "{index}\r"
        }
      }
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "elapsed_ms": 4000
      }
    },
    {
      "label": "→approval",
      "from": [
        "starting",
        "idle",
        "busy"
      ],
      "to": "approval",
      "priority": 100,
      "when": {
        "section": "footer",
        "matches": "(?:^|\\n)\\s*[❯›>]\\s*1\\.\\s*.+"
      }
    },
    {
      "label": "→picker",
      "from": [
        "idle",
        "busy"
      ],
      "to": "picker",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
      }
    },
    {
      "label": "idle→busy",
      "from": "idle",
      "to": "busy",
      "min_hold_ms": 1000,
      "when": {
        "section": "body",
        "matches": "(?:^|\\n)\\s*[·✢✳✶✽✷✸✹⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+\\w.*?(?:…|\\.\\.\\.)"
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "section": "body",
              "matches": "(?:^|\\n)\\s*[·✢✳✶✽✷✸✹⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+\\w.*?(?:…|\\.\\.\\.)"
            }
          },
          {
            "section": "body",
            "matches": "✻\\s+\\w.*?for\\s+\\d+[smh](?:\\s+\\d+[smh])*(?!.*\\btoken)"
          },
          {
            "stable_ms": 6000,
            "cursor_above": 4
          }
        ]
      }
    },
    {
      "label": "approval→busy",
      "from": [
        "approval",
        "picker"
      ],
      "to": "busy",
      "min_hold_ms": 1500,
      "when": {
        "section": "body",
        "matches": "(?:^|\\n)\\s*[·✢✳✶✽✷✸✹⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+\\w.*?(?:…|\\.\\.\\.)"
      }
    },
    {
      "label": "approval→idle",
      "from": [
        "approval",
        "picker"
      ],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*[❯›>]\\s*1\\.\\s*.+"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
            }
          },
          {
            "not": {
              "section": "body",
              "matches": "(?:^|\\n)\\s*[·✢✳✶✽✷✸✹⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+\\w.*?(?:…|\\.\\.\\.)"
            }
          },
          {
            "stable_ms": 3000,
            "cursor_above": 5
          }
        ]
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select (?:a |an )?model"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r"
      }
    },
    {
      "id": "cycle_mode",
      "label": "Mode",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b[Z"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Claude Code",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.claude/projects/{cwd_claude_project}/{session_id}.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": {
        "where": "$.type == 'user' || $.type == 'assistant'"
      },
      "message_map": {
        "role": "$.message.role",
        "content": "$.message.content",
        "timestamp_ms": "$.timestamp",
        "tools": {}
      }
    }
  }
}