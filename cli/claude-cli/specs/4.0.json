{
  "$schema": "adhdev:cli/spec@4",
  "id": "claude-cli",
  "name": "Claude Code",
  "binary": "claude",
  "cli_version_range": ">=2.1.0",
  "spawn_args": [
    "--permission-mode",
    "default"
  ],
  "_pre_launch_trust_note": "Added 2026-09-25: a delegated worker on a fresh WORKTREE clone always hit 'Is this a project you trust' and depended on the reactive auto-approve modal path (a standing human-approval precondition for automated work, same failure class as CODEX-WORKER-TRUST-STALL). claude-cli has NO worker-private HOME (absent from WORKER_PRIVATE_HOME_SPECS in mesh/worker-mcp-isolation.ts), so a delegated worker runs with the REAL HOME and this scheme always targets the owner's actual ~/.claude.json — verified live against this machine's own file: top-level `projects` is a JSON OBJECT keyed by the absolute realpath, each value carrying a boolean `hasTrustDialogAccepted` among many session-history fields Claude Code itself owns. The writer (providers/claude-workspace-trust.ts / spec/pre-launch-trust.ts) is therefore sparse: it sets ONLY that one field on the one key for this workspace, never touching sibling entries or other fields on the same entry.",
  "pre_launch_trust": {
    "scheme": "claude_json_projects"
  },
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200,
    "posix_bracketed_paste_for_images": true,
    "posix_bracketed_paste_text": true
  },
  "sections": {
    "footer": {
      "anchor": "^(?:[❯›>]|[│|]\\s*[❯›>])",
      "anchor_last": true
    },
    "modal": {
      "anchor": [
        "^[─╌]+$",
        "\\S"
      ],
      "anchor_last": true,
      "anchor_context": [
        {
          "next": "^(?![─╌]+$)"
        },
        {
          "next": "^\\s*[❯›➜]?\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*1\\.\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*\\S"
        }
      ],
      "until": "^\\s*(?:[❯›➜]|>(?=\\s|$))(?!\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*\\d+\\.)"
    },
    "body": {
      "from_top": 0,
      "until": "modal"
    },
    "status_tail": {
      "from_bottom": 12
    },
    "trust": {
      "anchor": "^\\s*Accessing workspace:\\s*$",
      "anchor_last": true
    }
  },
  "_trust_state_note": "Added 2026-10-10 (Claude Code 2.1.295/2.1.296, measured live on win32). The folder-trust dialog is now an UNNUMBERED cursor list with the refusal first and focused: `❯ No, exit` / `  Yes, I trust this folder` / `Enter to confirm · Esc to cancel`. →approval needs a `1.` row, so the dialog matched nothing: startup-grace took the session to idle with the dialog still up, the dashboard showed a ready session with no approval card, and the first message was typed into the dialog (a blind Enter there picks `No, exit`). `trust` is entered only when BOTH choice rows and the confirm hint are the last lines on screen, so the same words quoted in a transcript never match. Buttons are ordinal (label_group) and pressed by arrow keys from the cursor row, so either row order works; the optional `N.` keeps the older numbered layout on the same path. It exits back to `starting`, not `idle`: accepting the dialog is where the CLI's boot begins, and startup-grace must run from there before the first send. pre_launch_trust normally keeps this dialog from appearing at all; this state is what makes a miss visible and answerable instead of a silent wedge.",
  "_end_anchor_note": "busy→idle (transitions[4]) body regex: the completion-summary line `✻ … for Ns` must be followed only by non-activity lines up to the END OF THE SECTION. That end anchor used to be a bare `$`, which is correct without the m flag (JS `$` then matches only at end of input) but tripped the engine's spec lint (`uses ^ or $ without the m flag`) on every session start. It is now spelled `(?![\\s\\S])` — byte-for-byte the same end-of-input semantics, lint-clean. Do NOT fix the lint by adding the m flag instead: with m, `$` matches at the end of the summary line itself, the continuation clause becomes optional, and a stale `✻ … for Ns` line above a live spinner would read as idle.",
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true,
          "detail_until": "^\\s*(?:Do you want|Would you like|[❯›>]?\\s*\\d+\\.\\s)"
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*(\\d+)\\.\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2,
          "select_mode": "arrow_keys"
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "modal": true,
      "modal_kind": "picker",
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*(\\d+)\\.\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*(.+?)\\s*$",
          "key_for_index": "{index}\r"
        }
      }
    },
    {
      "id": "approval_resolving",
      "label": "Approval resolving",
      "status": "approval"
    },
    {
      "id": "approval_vanished",
      "label": "Approval clearing",
      "status": "approval"
    },
    {
      "id": "trust",
      "label": "Folder trust requested",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "trust",
          "first_line": true,
          "detail_until": "^\\s*(?:Security guide\\b|(?:[❯›>]\\s*)?(?:\\d+\\.\\s*)?(?:Yes, I trust this folder|No, exit)\\s*$)"
        },
        "buttons": {
          "section": "trust",
          "pattern": "^[ \\t]*(?:[❯›>][ \\t]*)?(?:\\d+\\.[ \\t]*)?(Yes, I trust this folder|No, exit)[ \\t]*$",
          "flags": "gm",
          "label_group": 1,
          "key_for_index": "\r",
          "min_count": 2,
          "select_mode": "arrow_keys"
        }
      }
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "elapsed_ms": 8000
      }
    },
    {
      "label": "→approval",
      "from": [
        "starting",
        "idle",
        "busy",
        "approval_resolving"
      ],
      "to": "approval",
      "priority": 100,
      "when": {
        "all": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
          },
          {
            "section": "footer",
            "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|\\(esc\\)|Do you want"
          },
          {
            "not": {
              "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
            }
          },
          {
            "any": [
              {
                "section": "footer",
                "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S[\\s\\S]*?(?:^|\\n)\\s*(?:[❯›]\\s*)?2\\.\\s+\\S"
              },
              {
                "not": {
                  "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "label": "→picker",
      "from": [
        "starting",
        "idle",
        "busy",
        "approval_resolving"
      ],
      "to": "picker",
      "priority": 110,
      "when": {
        "any": [
          {
            "all": [
              {
                "section": "modal",
                "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
              },
              {
                "not": {
                  "section": "modal",
                  "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|don't ask again\\b"
                }
              }
            ]
          },
          {
            "all": [
              {
                "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
              },
              {
                "section": "footer",
                "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?(?:\\[[ xX]\\]|[☐☒◻◼])?\\s*1\\.\\s*(?:\\[[ xX]\\]|[☐☒◻◼])?\\s+\\S"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "idle→busy",
      "from": [
        "idle",
        "starting"
      ],
      "to": "busy",
      "min_hold_ms": 1000,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "section": "body",
            "matches": "✻\\s+\\w[^\\n]*?\\bfor\\s+\\d+[smh](?:\\s+\\d+[smh])*(?![^\\n]*\\btokens?\\b)(?![^\\n]*[↑↓])[^\\n]*(?:\\n(?![^\\n]*(?:[✢✳✶✽✷✸✹⠀-⣿]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.)|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))[^\\n]*)*(?![\\s\\S])"
          },
          {
            "stable_ms": 8000,
            "ignore_lines": "^\\s*✻\\s+\\w(?:(?!\\bfor\\s+\\d)[^\\n])*$|^\\s*[↑↓]\\s*[\\d.]+[km]?\\s*tokens?[^\\n]*$"
          }
        ]
      }
    },
    {
      "label": "busy→idle-quiet",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "not": {
              "matches": "[↑↓]\\s*[\\d.]+[km]?\\s*tokens?"
            }
          },
          {
            "stable_ms": 12000,
            "ignore_lines": "^\\s*✻\\s+\\w(?:(?!\\bfor\\s+\\d)[^\\n])*$|^\\s*[↑↓]\\s*[\\d.]+[km]?\\s*tokens?[^\\n]*$"
          }
        ]
      }
    },
    {
      "label": "approval→resolving",
      "from": "approval",
      "to": "approval_resolving",
      "min_hold_ms": 2500,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|\\(esc\\)"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|during this session\\b|don't ask again\\b"
            }
          },
          {
            "not": {
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
            }
          },
          {
            "not": {
              "matches": "(?:^|\\n)\\s*[❯›]\\s*\\d+\\.\\s+\\S"
            }
          },
          {
            "section": "status_tail",
            "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
          }
        ]
      }
    },
    {
      "label": "approval-resolving→approval-no-spinner",
      "from": "approval_resolving",
      "to": "approval",
      "priority": 50,
      "when": {
        "not": {
          "section": "status_tail",
          "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
        }
      }
    },
    {
      "label": "approval-resolving→busy",
      "from": "approval_resolving",
      "to": "busy",
      "min_hold_ms": 1200,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "approval→idle",
      "from": [
        "approval",
        "picker"
      ],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|\\(esc\\)"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          },
          {
            "stable_ms": 3000,
            "cursor_above": 5
          }
        ]
      }
    },
    {
      "label": "approval→vanished",
      "from": [
        "approval",
        "picker"
      ],
      "to": "approval_vanished",
      "priority": 90,
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|\\(esc\\)"
            }
          },
          {
            "not": {
              "matches": "(?:^|\\n)\\s*[❯›]\\s*\\d+\\.\\s+\\S"
            }
          },
          {
            "not": {
              "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
            }
          },
          {
            "not": {
              "matches": "Enter to select\\b|(?:↑|↓|up|down)[\\s/]+(?:↑|↓)?\\s*to navigate\\b|(?:^|\\n)\\s*(?:[❯›]\\s*)?\\d+\\.\\s+(?:Type something|Chat about this)\\b"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
            }
          }
        ]
      }
    },
    {
      "label": "vanished→approval-modal-returned",
      "from": "approval_vanished",
      "to": "approval",
      "priority": 120,
      "when": {
        "any": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*(?:[❯›]\\s*)?1\\.\\s+\\S"
          },
          {
            "section": "footer",
            "matches": "Esc to cancel\\b|esc(?:ape)?\\s+to\\s+cancel\\b|press\\s+esc(?:ape)?\\b|\\(esc\\)"
          },
          {
            "matches": "(?:^|\\n)\\s*[❯›]\\s*\\d+\\.\\s+\\S"
          },
          {
            "matches": "Do you want to (?:proceed|create|make|edit|apply|run|delete|modify|allow)\\b|allow all edits\\b|(?:during this session|don't ask again)\\s*\\(shift"
          }
        ]
      }
    },
    {
      "label": "vanished→busy",
      "from": "approval_vanished",
      "to": "busy",
      "priority": 100,
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)\\s*[✢✳✶✽✷✸✹\\u2800-\\u28ff]\\s+\\w[^\\n]*?(?:…|\\.\\.\\.|\\d+[smh]\\b|[↑↓]\\s*[\\d.]+[km]?\\s*tokens?))|(?:(?:^|\\n)\\s*✻\\s+\\w[^\\n]*?[↑↓]\\s*[\\d.]+[km]?\\s*tokens?)|(?:(?:^|\\n)\\s*esc to (?:interrupt|stop)(?:\\s*[·•]\\s*ctrl\\+t[^\\n]*)?\\s*(?=\\n|$))|(?:(?:^|\\n)[^\\n()]{1,160}\\(\\s*esc to (?:interrupt|stop)\\s*[·•]\\s*ctrl\\+t[^\\n)]*\\)\\s*(?=\\n|$))"
      }
    },
    {
      "label": "vanished→idle",
      "from": "approval_vanished",
      "to": "idle",
      "priority": 10,
      "when": {
        "elapsed_ms": 1200
      }
    },
    {
      "label": "→trust",
      "from": [
        "starting",
        "idle"
      ],
      "to": "trust",
      "priority": 130,
      "when": {
        "section": "trust",
        "matches": "(?:^|\\n)[ \\t]*(?:[❯›>][ \\t]*)?(?:\\d+\\.[ \\t]*)?(?:Yes, I trust this folder|No, exit)[ \\t]*\\n[ \\t]*(?:[❯›>][ \\t]*)?(?:\\d+\\.[ \\t]*)?(?:Yes, I trust this folder|No, exit)[ \\t]*\\n\\s*Enter to confirm[^\\n]*\\s*(?![\\s\\S])"
      }
    },
    {
      "label": "trust→starting",
      "from": "trust",
      "to": "starting",
      "min_hold_ms": 300,
      "when": {
        "not": {
          "section": "trust",
          "matches": "(?:^|\\n)[ \\t]*(?:[❯›>][ \\t]*)?(?:\\d+\\.[ \\t]*)?(?:Yes, I trust this folder|No, exit)[ \\t]*\\n[ \\t]*(?:[❯›>][ \\t]*)?(?:\\d+\\.[ \\t]*)?(?:Yes, I trust this folder|No, exit)[ \\t]*\\n\\s*Enter to confirm[^\\n]*\\s*(?![\\s\\S])"
        }
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select (?:a |an )?model"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r",
        "select_mode": "arrow_keys"
      }
    },
    {
      "id": "cycle_mode",
      "label": "Mode",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b[Z"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Claude Code",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.claude/projects/{cwd_claude_project}/{session_id}.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": {
        "where": "$.type == 'user' || $.type == 'assistant'"
      },
      "message_map": {
        "role": "$.message.role",
        "content": "$.message.content",
        "timestamp_ms": "$.timestamp",
        "tools": {}
      }
    }
  }
}
