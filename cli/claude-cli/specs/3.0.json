{
  "$schema": "adhdev:cli/spec@3",
  "id": "claude-cli",
  "name": "Claude Code",
  "binary": "claude",
  "cli_version_range": ">=2.1.0",
  "spawn_args": [
    "--permission-mode",
    "default"
  ],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "sections": {
    "footer": {
      "anchor": "^[❯›>]",
      "anchor_last": true
    },
    "modal": {
      "anchor": "^[─╌]+$",
      "anchor_last": true,
      "anchor_context": {
        "next": "^(?![─╌]+$)"
      },
      "until": "^\\s*[❯›>➜](?!\\s*\\d+\\.)"
    },
    "body": {
      "from_top": 0,
      "until": "modal"
    },
    "status": {
      "from_bottom": 4,
      "until": "footer"
    }
  },
  "states": [
    {
      "id": "approval",
      "label": "Approval requested",
      "when": {
        "all": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*[❯›>]\\s*1\\.\\s*.+"
          }
        ]
      },
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "when": {
        "all": [
          {
            "section": "modal",
            "matches": "Select (?:a |an )?(?:model|mode|option)\\b|Switch between"
          }
        ]
      },
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s*(.+?)\\s*$",
          "key_for_index": "{index}\r"
        }
      }
    },
    {
      "id": "busy",
      "label": "Generating",
      "when": {
        "any": [
          {
            "section": "status",
            "matches": "esc to interrupt|[↓↑]\\s*\\d+(?:[.,]\\d+)?\\s*[kKmM]?\\s*tokens|✢\\s+\\w"
          },
          {
            "cursor_above": 3,
            "changed": true
          }
        ]
      }
    },
    {
      "id": "idle",
      "label": "Ready",
      "when": {
        "all": [
          {
            "section": "footer",
            "matches": "(?:^|\\n)\\s*[❯›>]\\s*(?:\\n|$)"
          },
          {
            "section": "body",
            "not_matches": "⏺|✳|Thinking\\.\\.\\.|Working\\.\\.\\.|Philosophising\\.\\.\\."
          }
        ]
      }
    }
  ],
  "default_state": "idle",
  "timing": {
    "busy_hold_ms": 6000,
    "idle_hold_ms": 1500,
    "screen_active_hold_ms": 2000,
    "completion_marker": {
      "section": "body",
      "matches": "✻\\s+\\w+ed\\s+for\\s+(?:\\d+h\\s+)?(?:\\d+m\\s+)?\\d+s\\b",
      "hold_ms": 5000,
      "force_after_ms": 8000
    }
  },
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select a model"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Claude Code",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.claude/projects/{cwd_dashed}/{session_id}.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": {
        "where": "$.type == 'user' || $.type == 'assistant'"
      },
      "message_map": {
        "role": "$.message.role",
        "content": "$.message.content",
        "timestamp_ms": "$.timestamp"
      }
    }
  }
}
