{
  "$schema": "adhdev:cli/spec@1",
  "id": "claude-cli",
  "binary": "claude",
  "spawn_args": ["--permission-mode", "default"],
  "send": {
    "submit": "\r"
  },
  "decision": {
    "numbered_choice_pattern": "^\\s*(?:[❯›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$",
    "footer_patterns": [
      "Esc to cancel"
    ],
    "min_choices": 2,
    "choice_key": "{index}\r"
  },
  "busy": {
    "patterns": [
      "esc to interrupt"
    ]
  },
  "idle": {
    "patterns": [
      "(?:^|\\n)\\s*[❯›>]\\s*(?:\\n|$)"
    ]
  }
}
