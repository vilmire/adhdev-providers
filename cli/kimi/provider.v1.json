{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "kimi",
  "name": "Kimi Code",
  "displayName": "Kimi Code",
  "category": "cli",
  "aliases": [
    "kimi-code",
    "kimi-cli"
  ],
  "icon": "🌙",
  "status": "Beta",
  "details": "Terminal only",
  "links": {
    "homepage": "https://kimi.ai",
    "docs": "https://kimi.ai/kimi-code"
  },
  "install": {
    "manual": "Install Kimi Code, then run `kimi login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.0.3",
  "binary": "kimi",
  "spawn": {
    "command": "kimi",
    "args": [],
    "shell": false
  },
  "autoApproveModes": {
    "default": "pty-parse",
    "modes": [
      {
        "id": "pty-parse",
        "label": "PTY parse (interactive)",
        "strategy": "pty-parse-default",
        "risk": "safe"
      },
      {
        "id": "yolo",
        "label": "YOLO",
        "strategy": "launch-args",
        "risk": "caution",
        "warning": "도구 호출 자동 승인(질문은 가능)",
        "launchArgs": [
          "--yolo"
        ]
      },
      {
        "id": "auto",
        "label": "Auto (fully autonomous)",
        "strategy": "launch-args",
        "risk": "dangerous",
        "warning": "완전 자율 — 질문하지 않음",
        "launchArgs": [
          "--auto"
        ]
      }
    ]
  },
  "modelLaunchArgs": [
    "-m",
    "{{model}}"
  ],
  "modelOptions": [
    "kimi-code/kimi-for-coding",
    "kimi-code/kimi-for-coding-highspeed",
    "kimi-code/k3"
  ],
  "sendDelayMs": 1200,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "string",
    "resumeSessionArgs": [
      "-S",
      "session_{{id}}"
    ],
    "resumeArgs": [
      "--continue"
    ]
  },
  "transcriptAuthority": "provider",
  "nativeHistory": {
    "mode": "native-source",
    "contractVersion": "2.0",
    "source": {
      "kind": "jsonl",
      "path": "~/.kimi-code/sessions/*/session_*/agents/main",
      "file_pattern": "wire.jsonl",
      "session_id_from": "dir_uuid",
      "workspace_from_sidecar": {
        "rel_path": "../../state.json",
        "workspace_path": "$.workDir"
      },
      "records": [
        {
          "where": "$.type == \"turn.prompt\"",
          "message_map": {
            "role": "user",
            "content": "$.input",
            "timestamp_ms": "$.time"
          }
        },
        {
          "where": "$.type == \"context.append_loop_event\" && $.event.type == \"content.part\" && $.event.part.type == \"text\"",
          "message_map": {
            "role": "assistant",
            "content": "$.event.part.text",
            "timestamp_ms": "$.time"
          }
        },
        {
          "where": "$.type == \"context.append_loop_event\" && $.event.type == \"tool.call\"",
          "message_map": {
            "role": "assistant",
            "content": "$.event.name",
            "timestamp_ms": "$.time",
            "tools": {
              "block_type": "$.event.type",
              "call_types": ["tool.call"],
              "result_types": ["tool.result"],
              "call_name": "$.event.name",
              "call_args": "$.event.args"
            }
          }
        },
        {
          "where": "$.type == \"context.append_loop_event\" && $.event.type == \"tool.result\"",
          "message_map": {
            "role": "assistant",
            "content": "$.event.type",
            "timestamp_ms": "$.time",
            "tools": {
              "block_type": "$.event.type",
              "call_types": ["tool.call"],
              "result_types": ["tool.result"],
              "result_content": "$.event.result.output"
            }
          }
        }
      ],
      "usage_records": [
        {
          "where": "$.type == \"usage.record\"",
          "usage_map": {
            "mode": "delta",
            "input_tokens": "$.usage.inputOther",
            "output_tokens": "$.usage.output",
            "cache_read_tokens": "$.usage.inputCacheRead",
            "cache_creation_tokens": "$.usage.inputCacheCreation",
            "model": "$.model",
            "timestamp_ms": "$.time"
          }
        }
      ]
    }
  },
  "tui": {
    "welcomeScreen": {
      "$schema": "adhdev:tui/welcome-screen@1",
      "cues": [
        { "pattern": "Welcome to Kimi Code" },
        { "pattern": "Migrate from kimi-cli" },
        { "pattern": "High Speed mode is ready" }
      ]
    },
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "[🌑🌒🌓🌔🌕🌖🌗🌘]\\s*·\\s*Tip:",
          "description": "Moon-phase spinner cycling next to '· Tip:' — the sole reliable generation indicator (observed kimi-code v0.24)"
        },
        {
          "regex": "[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+MCP server",
          "description": "Braille spinner while an MCP server is connecting at startup"
        },
        {
          "regex": "MCP server .+ connecting",
          "flags": "i",
          "description": "MCP connect activity during boot"
        },
        {
          "regex": "[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+working\\.\\.\\.",
          "description": "Braille spinner + 'working...' — observed live during K3 tool-execution phases (kimi-code v0.28.1); distinct from the MCP-connect braille spinner above"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 12
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "│\\s*>\\s*│",
      "flags": "m",
      "scope": "last-n-lines",
      "scopeWindowLines": 8
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Run this command\\?|Execute this command\\?|Do you want to (?:proceed|run|allow|execute|make|apply|continue)|Apply this edit\\?|Make this edit\\?|Apply these changes\\?",
      "questionFlags": "i",
      "buttonPattern": "^\\s*([❯›>▶●•]\\s*)?\\d+[.)]\\s+(.+)$",
      "buttonLabelGroup": 2,
      "buttonFlags": "m",
      "scope": "window-around-question",
      "scopeWindowLines": 20
    },
    "approvalSquash": {
      "$schema": "adhdev:tui/approval-squash@1",
      "buttonRules": [
        {
          "compact": "1approveonce2approveforthissession3reject4rejectwithfeedback",
          "labels": [
            "Approve once",
            "Approve for this session",
            "Reject",
            "Reject with feedback"
          ]
        },
        {
          "compact": "1allow2allowforsession3reject4rejectwithfeedback",
          "labels": [
            "Allow",
            "Allow for session",
            "Reject",
            "Reject with feedback"
          ]
        }
      ],
      "scope": "tail-window",
      "tailWindowLines": 20
    },
    "transcriptPty": {
      "$schema": "adhdev:tui/transcript-pty@1",
      "assistantPrefix": {
        "regex": "^\\s*●\\s+(.*)$",
        "description": "Filled circle bullet (rendered with one leading pad space) — assistant response lines"
      },
      "userPrefix": {
        "regex": "^\\s*✨\\s+(.*)$",
        "description": "Sparkle echo (one leading pad space) — user turn echo"
      },
      "chromePatterns": [
        {
          "regex": "^\\s*[🌑🌒🌓🌔🌕🌖🌗🌘]\\s*·\\s*Tip:",
          "label": "spinner-tip"
        },
        {
          "regex": "^\\s*[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+MCP server",
          "label": "mcp-spinner"
        },
        {
          "regex": "kimi-for-coding(?:-highspeed)?\\s+(?:thinking|idle)",
          "flags": "i",
          "label": "status-bar"
        },
        {
          "regex": "context:\\s*\\d+(?:\\.\\d+)?%",
          "label": "context-meter"
        },
        {
          "regex": "^\\s*(?:╭|╰|│\\s*>|╰────)",
          "label": "input-box-chrome"
        },
        {
          "regex": "MCP server .+ (?:connected|connecting)",
          "flags": "i",
          "label": "mcp-connected"
        },
        {
          "regex": "✦\\s+High Speed mode",
          "label": "highspeed-banner"
        },
        {
          "regex": "✦\\s+Use Kimi K3 with .+ thinking effort|Run /model to switch to K3",
          "flags": "i",
          "label": "k3-onboarding-banner"
        },
        {
          "regex": "Welcome to Kimi Code|Send /help for help|^\\s*Directory:|^\\s*Session:|^\\s*Model:|^\\s*Version:",
          "label": "welcome-banner"
        },
        {
          "regex": "[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\\s+working\\.\\.\\.",
          "label": "working-spinner"
        },
        {
          "regex": "\\(\\d+ more lines?, ctrl\\+o to expand\\)",
          "label": "collapsed-hint"
        }
      ],
      "scope": "buffer"
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt"
      ],
      "onNoMatch": "preserve-last"
    }
  },
  "overrides": {},
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the AGENTS.md block as a user-role message in the chat."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls (passes --yolo to kimi)"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": false,
      "mediaTypes": [
        "text"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
