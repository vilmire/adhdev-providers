{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "cursor-cli",
  "name": "Cursor Agent",
  "displayName": "Cursor Agent",
  "category": "cli",
  "aliases": [
    "cursor-agent",
    "cursor"
  ],
  "icon": "⚡",
  "status": "Beta",
  "details": "Terminal only",
  "links": {
    "homepage": "https://cursor.com",
    "docs": "https://docs.cursor.com/agent"
  },
  "install": {
    "manual": "Install Cursor from https://cursor.com, then run `cursor-agent login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.0.1",
  "binary": "cursor-agent",
  "spawn": {
    "command": "cursor-agent",
    "args": [
      "--trust"
    ],
    "shell": false
  },
  "autoApproveModes": {
    "default": "pty-parse",
    "modes": [
      {
        "id": "pty-parse",
        "label": "PTY parse (interactive)",
        "strategy": "pty-parse-default",
        "risk": "safe"
      },
      {
        "id": "force",
        "label": "Force",
        "strategy": "launch-args",
        "risk": "dangerous",
        "warning": "모든 명령을 강제 허용",
        "launchArgs": [
          "--force"
        ]
      }
    ]
  },
  "modelLaunchArgs": [
    "--model",
    "{{model}}"
  ],
  "modelOptions": [
    "auto",
    "gpt-5.3-codex",
    "gpt-5.3-codex-low",
    "gpt-5.3-codex-high",
    "gpt-5.3-codex-xhigh",
    "gpt-5.3-codex-fast",
    "gpt-5.3-codex-high-fast",
    "gpt-5.3-codex-xhigh-fast",
    "gpt-5.2",
    "gpt-5.2-codex",
    "gpt-5.2-codex-low",
    "gpt-5.2-codex-high",
    "gpt-5.2-codex-xhigh",
    "gpt-5.1-codex-max-low",
    "gpt-5.1-codex-max-medium",
    "gpt-5.1-codex-max-high",
    "gpt-5.1-codex-max-xhigh",
    "gpt-5.6-sol-high",
    "gpt-5.6-sol-xhigh",
    "gpt-5.6-luna-low",
    "gpt-5.6-luna-medium",
    "gpt-5.6-luna-high",
    "gpt-5.6-luna-xhigh",
    "gpt-5.6-luna-max",
    "gpt-5.5-high",
    "gpt-5.4-mini-none",
    "gpt-5.4-mini-low",
    "gpt-5.4-mini-medium",
    "gpt-5.4-mini-high",
    "gpt-5.4-mini-xhigh",
    "gpt-5.4-nano-medium",
    "gpt-5.4-nano-high",
    "gpt-5.1-low",
    "gpt-5.1",
    "gpt-5.1-high",
    "gpt-5.1-codex-mini-low",
    "gpt-5.1-codex-mini",
    "gpt-5.1-codex-mini-high",
    "gpt-5-mini",
    "claude-opus-4-8-thinking-high",
    "claude-fable-5-thinking-high",
    "claude-4.5-sonnet",
    "claude-4.5-sonnet-thinking",
    "claude-4-sonnet",
    "claude-4-sonnet-thinking",
    "cursor-grok-4.5-high",
    "composer-2.5",
    "gemini-3.1-pro",
    "gemini-3-flash",
    "gemini-3.5-flash",
    "kimi-k2.7-code",
    "glm-5.2-high",
    "glm-5.2-max"
  ],
  "sendDelayMs": 1200,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "uuid",
    "resumeSessionArgs": [
      "--resume",
      "{{id}}"
    ],
    "resumeArgs": [
      "--continue"
    ]
  },
  "transcriptAuthority": "provider",
  "nativeHistory": {
    "mode": "native-source",
    "contractVersion": "2.0",
    "source": {
      "kind": "jsonl",
      "path": "~/.cursor/projects/*/agent-transcripts/*",
      "file_pattern": "*.jsonl",
      "session_id_from": "filename_uuid",
      "workspace_from_input": true,
      "message_map": {
        "role": "$.role",
        "content": "$.message.content",
        "content_strip": [
          "timestamp"
        ],
        "content_unwrap": [
          "user_query"
        ],
        "tools": {}
      }
    }
  },
  "tui": {
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "\\bWorking\\b",
          "description": "Generation indicator: a braille glyph + 'Working' shown while the agent runs (observed: cursor-agent v2026.07.09)"
        },
        {
          "regex": "(?:ctrl\\+c|esc) to (?:cancel|interrupt|stop|skip)",
          "flags": "i",
          "description": "Interrupt hint (e.g. 'ctrl+c to stop') present only during a run"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 12
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "^\\s*\\S[^\\n]*·\\s*\\d+(?:\\.\\d+)?%[^\\n]*\\n\\s*(?:~|/)[^\\n]+$",
      "flags": "m",
      "scope": "last-n-lines",
      "scopeWindowLines": 8,
      "description": "Idle footer: label line carrying the context-percent ('Kimi K2.7 Code · 6.8%' on v2026.08; 'Auto · 7.7%' on older builds) followed by the workspace path line ('/abs/path' or '~/...'). During generation the 'Working' spinner replaces the label line — and dispatchOrder checks the spinner first, so a mid-run footer can never win this match."
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Run this command|Allow|Do you want to|Do you trust|Trust|approve|Approve|permission",
      "questionFlags": "i",
      "buttonPattern": "^[\\s│┃|]*(?:[❯›>▶●→]\\s*)?(?:(?:\\d+[.)]|\\[[A-Za-z]\\])\\s+([^│┃|]+?)|(\\S[^│┃|]*?)\\s*\\((?:y|n|tab|shift\\+tab|esc(?:\\s+or\\s+n)?)\\))\\s*[│┃|]?\\s*$",
      "buttonLabelGroup": 1,
      "buttonFlags": "m",
      "scope": "window-around-question",
      "scopeWindowLines": 20
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt"
      ],
      "onNoMatch": "preserve-last"
    },
    "transcriptPty": {
      "$schema": "adhdev:tui/transcript-pty@1",
      "assistantPrefix": {
        "regex": "^\\s*(\\S.*)$",
        "description": "cursor-agent renders the assistant answer as a plain no-background line with no distinctive bullet — capture any non-empty body line. The user's submitted message and composer echo are rendered inside a colored box and are classified as USER turns via userBackgroundSgr BEFORE this permissive rule runs, so they no longer leak into an assistant bubble. Remaining chrome (footer, spinner, follow-up hint, mode label, workspace path, input box, tips) is excluded via chromePatterns."
      },
      "userBackgroundSgr": [
        "*"
      ],
      "chromePatterns": [
        {
          "regex": "\\bWorking\\b",
          "label": "spinner-working"
        },
        {
          "regex": "(?:ctrl\\+c|esc) to (?:cancel|interrupt|stop|skip)",
          "flags": "i",
          "label": "interrupt-hint"
        },
        {
          "regex": "^\\s*(?:Auto|Plan|Ask)\\b[^\\n]*·",
          "label": "mode-footer"
        },
        {
          "regex": "^\\s*(?:Auto|Plan|Ask)\\s*$",
          "label": "mode-label-idle"
        },
        {
          "regex": "^\\s*→\\s+Add a follow-up",
          "flags": "i",
          "label": "follow-up-hint"
        },
        {
          "regex": "^\\s*→\\s+Plan, search, build anything\\s*$",
          "label": "composer-placeholder"
        },
        {
          "regex": "^\\s*(?:Kimi|GPT|Claude|Gemini|Grok|Composer|Sonnet|Opus|DeepSeek|Qwen|Llama|Mistral)[\\w.\\-+ ]*\\s*$",
          "label": "model-label"
        },
        {
          "regex": "^\\s*Tip:",
          "flags": "i",
          "label": "tip-hint"
        },
        {
          "regex": "^\\s*Cursor Agent\\s*$",
          "label": "startup-banner"
        },
        {
          "regex": "^\\s*v\\d+\\.\\d",
          "label": "version-line"
        },
        {
          "regex": "^\\s*(?:~|/)[^\\n]*$",
          "label": "workspace-path"
        },
        {
          "regex": "·\\s*$",
          "label": "workspace-path-continuation"
        },
        {
          "regex": "^\\s*[A-Za-z][\\w.-]*/[\\w./-]+\\s*$",
          "label": "git-branch-footer"
        },
        {
          "regex": "^\\s*[╭╰│>❯›]",
          "label": "input-box-chrome"
        }
      ],
      "stripLeadingChrome": true,
      "scope": "buffer"
    }
  },
  "approvalPositiveHints": [
    "trust",
    "trust this workspace",
    "allow",
    "approve",
    "accept",
    "run",
    "yes"
  ],
  "overrides": {},
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the AGENTS.md / developer_instructions block as a user-role message in the chat. Off by default — the prompt is still visible via the chat header's ⓘ Session Info dialog."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls (passes --force to cursor-agent)"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "auto_import",
      "format": "claude_mcp_json",
      "path": ".cursor/mcp.json",
      "serverName": "adhdev-mesh"
    },
    "systemPromptInjection": {
      "mode": "context_file",
      "path": ".cursor/rules/adhdev-mesh-coordinator.mdc",
      "wrapper": "---\ndescription: adhdev mesh coordinator\nalwaysApply: true\n---\n<!-- adhdev-mesh-coordinator-prompt -->\n{prompt}\n<!-- /adhdev-mesh-coordinator-prompt -->\n",
      "owned": true
    },
    "launchArgs": [
      "--approve-mcps"
    ]
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
