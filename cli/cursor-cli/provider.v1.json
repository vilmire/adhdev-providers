{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "cursor-cli",
  "name": "Cursor Agent",
  "displayName": "Cursor Agent",
  "category": "cli",
  "aliases": [
    "cursor-agent",
    "cursor"
  ],
  "icon": "⚡",
  "status": "Beta",
  "details": "Terminal only",
  "links": {
    "homepage": "https://cursor.com",
    "docs": "https://docs.cursor.com/agent"
  },
  "install": {
    "manual": "Install Cursor from https://cursor.com, then run `cursor-agent login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.0.0",
  "binary": "cursor-agent",
  "spawn": {
    "command": "cursor-agent",
    "args": [],
    "shell": false
  },
  "modelLaunchArgs": [
    "--model",
    "{{model}}"
  ],
  "modelOptions": [
    "auto",
    "gpt-5.3-codex",
    "gpt-5.3-codex-low",
    "gpt-5.3-codex-high",
    "gpt-5.3-codex-xhigh",
    "gpt-5.3-codex-fast",
    "gpt-5.3-codex-high-fast",
    "gpt-5.3-codex-xhigh-fast",
    "gpt-5.2",
    "gpt-5.2-codex",
    "gpt-5.2-codex-low",
    "gpt-5.2-codex-high",
    "gpt-5.2-codex-xhigh",
    "gpt-5.1-codex-max-low",
    "gpt-5.1-codex-max-medium",
    "gpt-5.1-codex-max-high",
    "gpt-5.1-codex-max-xhigh",
    "gpt-5.6-sol-high",
    "gpt-5.6-sol-xhigh",
    "gpt-5.6-luna-low",
    "gpt-5.6-luna-medium",
    "gpt-5.6-luna-high",
    "gpt-5.6-luna-xhigh",
    "gpt-5.6-luna-max",
    "gpt-5.5-high",
    "gpt-5.4-mini-none",
    "gpt-5.4-mini-low",
    "gpt-5.4-mini-medium",
    "gpt-5.4-mini-high",
    "gpt-5.4-mini-xhigh",
    "gpt-5.4-nano-medium",
    "gpt-5.4-nano-high",
    "gpt-5.1-low",
    "gpt-5.1",
    "gpt-5.1-high",
    "gpt-5.1-codex-mini-low",
    "gpt-5.1-codex-mini",
    "gpt-5.1-codex-mini-high",
    "gpt-5-mini",
    "claude-opus-4-8-thinking-high",
    "claude-fable-5-thinking-high",
    "claude-4.5-sonnet",
    "claude-4.5-sonnet-thinking",
    "claude-4-sonnet",
    "claude-4-sonnet-thinking",
    "cursor-grok-4.5-high",
    "composer-2.5",
    "gemini-3.1-pro",
    "gemini-3-flash",
    "gemini-3.5-flash",
    "kimi-k2.7-code",
    "glm-5.2-high",
    "glm-5.2-max"
  ],
  "sendDelayMs": 1200,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "uuid",
    "resumeSessionArgs": [
      "--resume",
      "{{id}}"
    ],
    "resumeArgs": [
      "--continue"
    ]
  },
  "tui": {
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "Auto\\s*\\n\\s*~/",
          "description": "Status bar present during generation (cell-by-cell render — match heuristic)"
        },
        {
          "regex": "esc to (?:cancel|interrupt|stop)",
          "flags": "i"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 12
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "(?:Auto|[a-z0-9._-]+)\\s*\\n\\s*~/[^\\n]*\\s*·\\s*[^\\n]+",
      "flags": "m",
      "scope": "last-n-lines",
      "scopeWindowLines": 8
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Run this command|Allow|Do you want to|Trust|approve|Approve",
      "questionFlags": "i",
      "buttonPattern": "^\\s*([❯›>]\\s*)?\\d+[.)]\\s+(.+)$",
      "buttonLabelGroup": 2,
      "buttonFlags": "m",
      "scope": "window-around-question",
      "scopeWindowLines": 20
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt"
      ],
      "onNoMatch": "preserve-last"
    }
  },
  "overrides": {},
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the AGENTS.md / developer_instructions block as a user-role message in the chat. Off by default — the prompt is still visible via the chat header's ⓘ Session Info dialog."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls (passes --force to cursor-agent)"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "auto_import",
      "format": "claude_mcp_json",
      "path": ".cursor/mcp.json",
      "serverName": "adhdev-mesh"
    },
    "systemPromptInjection": {
      "mode": "cli_arg",
      "flag": "--rules"
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
