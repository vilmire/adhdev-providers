{
  "$schema": "adhdev:cli/spec@4",
  "id": "hermes-cli",
  "name": "Hermes Agent",
  "binary": "hermes",
  "cli_version_range": ">=0.14.0",
  "spawn_args": ["chat"],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 500
  },
  "_sections_note": "Measured live against Hermes Agent v0.14.0 on 2026-06-15 via /api/cli/debug/hermes-cli. The OLD spec used `footer { anchor: '^[❯>]', anchor_last:true }` plus `modal { from_bottom:16, until:'footer' }` and `status { from_bottom:4, until:'footer' }`. That footer anchor ONLY matches the bare idle prompt line `❯`; in BUSY the prompt line renders as `⚕ ❯ msg=interrupt · ...` and in APPROVAL it renders as `⚠ ❯`, neither of which starts with ❯/>. When the footer anchor fails, evaluator.ts defaults the section to the whole screen (from=0), so every `until:'footer'` section clamps toLine = footer.fromLine = 0 and starves to ZERO lines. Measured proof at a live `⚠️  Dangerous Command` modal: status=generating (WRONG), sections[modal].text='' (0 lines), →approval condResult=FALSE — FSM stuck in busy. Fix mirrors the codex rewrite: `modal` self-anchors on its own landmark with no `until`; `body` is the whole screen; busy/idle/approval guards run against those self-contained sections. Every anchor string below was seen verbatim in live screen capture.",
  "sections": {
    "modal": {
      "anchor": "⚠️\\s*Dangerous Command|Dangerous Command|Approval required|Permission required|Allow once|Allow for this session|Add to permanent allowlist|↑/↓ to select, Enter to confirm|Select a model|switch model|Model picker"
    },
    "body": {
      "from_top": 0
    },
    "composer": {
      "anchor": "^\\s*[❯>]\\s*$",
      "anchor_last": true,
      "lines": 1
    },
    "status": {
      "anchor": "^\\s*⚕\\s.*│",
      "anchor_last": true,
      "lines": 1
    }
  },
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:│\\s*)?(?:[❯>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*(?:│\\s*)?$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "modal": true,
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:│\\s*)?(?:[❯>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*(?:│\\s*)?$",
          "flags": "gm",
          "key_for_index": "{index}\r"
        }
      }
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "all": [
          {
            "elapsed_ms": 3000
          },
          {
            "any": [
              {
                "section": "body",
                "matches": "Welcome to Hermes Agent"
              },
              {
                "section": "composer",
                "matches": "[❯>]"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "startup-timeout",
      "from": "starting",
      "to": "idle",
      "when": {
        "elapsed_ms": 15000
      }
    },
    {
      "label": "→approval",
      "from": ["starting", "idle", "busy"],
      "to": "approval",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Dangerous Command|Approval required|Permission required|Do you want to (?:proceed|allow|run|create|edit|delete|modify)|Allow once|Allow for this session|Add to permanent allowlist"
      }
    },
    {
      "label": "→picker",
      "from": ["idle", "busy"],
      "to": "picker",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Select a model|switch model|Model picker"
      }
    },
    {
      "label": "idle→busy",
      "from": "idle",
      "to": "busy",
      "when": {
        "section": "body",
        "matches": "msg=interrupt|Ctrl\\+C cancel|/steer|Enter to interrupt"
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 400,
      "when": {
        "all": [
          {
            "not": {
              "section": "body",
              "matches": "msg=interrupt|Ctrl\\+C cancel|/steer|Enter to interrupt"
            }
          },
          {
            "section": "composer",
            "matches": "[❯>]"
          },
          {
            "stable_ms": 1500,
            "cursor_above": 4
          }
        ]
      }
    },
    {
      "label": "approval→busy",
      "from": ["approval", "picker"],
      "to": "busy",
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Dangerous Command|Approval required|Permission required|Do you want to (?:proceed|allow|run|create|edit|delete|modify)|Allow once|Allow for this session|Add to permanent allowlist|Select a model|switch model|Model picker"
            }
          },
          {
            "section": "body",
            "matches": "msg=interrupt|Ctrl\\+C cancel|/steer|Enter to interrupt"
          }
        ]
      }
    },
    {
      "label": "approval→idle",
      "from": ["approval", "picker"],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Dangerous Command|Approval required|Permission required|Do you want to (?:proceed|allow|run|create|edit|delete|modify)|Allow once|Allow for this session|Add to permanent allowlist"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select a model|switch model|Model picker"
            }
          },
          {
            "section": "composer",
            "matches": "[❯>]"
          },
          {
            "stable_ms": 800,
            "cursor_above": 5
          }
        ]
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": ["busy"],
      "action": {
        "type": "send_keys",
        "keys": ""
      }
    },
    {
      "id": "queue",
      "label": "Queue message",
      "visible_when_state": ["busy"],
      "action": {
        "type": "send_keys",
        "keys": "/queue\r"
      }
    },
    {
      "id": "background",
      "label": "Background",
      "visible_when_state": ["busy"],
      "action": {
        "type": "send_keys",
        "keys": "/bg\r"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": ["idle"],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select a model|switch model|Model picker"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:│\\s*)?(?:[❯>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*(?:│\\s*)?$"
        },
        "submit_key": "{index}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Hermes",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "sqlite",
      "path": "${HERMES_HOME:-~/.hermes}/state.db",
      "session_query": "SELECT id FROM sessions WHERE source = 'cli' AND message_count > 0 AND started_at >= ? ORDER BY started_at DESC LIMIT 1",
      "message_query": "SELECT role, content, CAST(timestamp * 1000 AS INTEGER) AS ts_ms FROM messages WHERE session_id = ? AND content IS NOT NULL AND content != '' AND role IN ('user', 'assistant', 'system', 'tool') ORDER BY timestamp ASC, id ASC",
      "message_map": {
        "role": "$.role",
        "content": "$.content",
        "timestamp_ms": "$.ts_ms",
        "tools": {
          "block_type": "$.role",
          "call_types": [],
          "result_types": ["tool"],
          "result_content": "$.content"
        }
      }
    }
  }
}
