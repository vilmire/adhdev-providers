{
  "$schema": "adhdev:cli/spec@4",
  "id": "grok-cli",
  "name": "Grok Build",
  "binary": "grok",
  "cli_version_range": ">=1.0.0",
  "spawn_args": [
    "--permission-mode",
    "acceptEdits"
  ],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "_notes": [
    "Authored from live PTY captures of grok 1.0.4 rendered through ghostty-vt,",
    "not from --help text. Grok's TUI gives three unambiguous signals, so this",
    "spec is much smaller than claude-cli's:",
    "  generating -> a braille spinner line carrying an elapsed '<n>s' plus a",
    "                '[stop]' control, and the footer gains 'Esc:cancel'.",
    "  idle       -> the input box '│ ❯' is empty and the footer is exactly",
    "                'Shift+Tab:mode │ Ctrl+x:shortcuts' (no Esc:cancel).",
    "  modal      -> radio rows 'N (●)/(○) label' plus a 'N/M:select' footer.",
    "Verified live: a bare number key both selects AND confirms (no Enter), so",
    "buttons use select_mode 'index' with key_for_index '{index}' and no \\r.",
    "consent_banner and trust_owner_attention are owner-attention parks",
    "(status waiting_external + owner_attention): no modal, no buttons, never",
    "answered automatically. Owner decision for 'Help improve Grok' is opt out;",
    "worker homes are pre-seeded with the privacy acknowledgment instead."
  ],
  "pre_launch_trust": {
    "scheme": "grok_toml_file"
  },
  "sections": {
    "footer": {
      "anchor": "^\\s*(?:\\d+/\\d+:select|Shift\\+Tab:mode|Enter:send|1/\\d+:select)",
      "anchor_last": true
    },
    "modal": {
      "anchor": [
        "^\\s*(?:[┃❙|]\\s*)?\\d+\\s*\\([●○]\\)\\s+\\S"
      ],
      "anchor_last": false,
      "until": "^\\s*\\d+/\\d+:select"
    },
    "body": {
      "from_top": 0,
      "until": "modal"
    },
    "status_tail": {
      "from_bottom": 14
    }
  },
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[┃❙|]\\s*)?(\\d+)\\s*\\([●○]\\)\\s*(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}",
          "min_count": 2,
          "select_mode": "index"
        }
      }
    },
    {
      "id": "trust",
      "label": "Workspace trust",
      "modal": true,
      "modal_kind": "confirm",
      "extract": {
        "title": {
          "regex": "Do you trust the contents of this directory\\?",
          "flags": "i"
        },
        "buttons": {
          "pattern": "^\\s*(\\S[^\\n]*?)\\s{2,}([yn])\\s*$",
          "flags": "gm",
          "label_group": 1,
          "key_group": 2,
          "min_count": 2
        }
      }
    },
    {
      "id": "trust_owner_attention",
      "label": "Owner attention: Grok workspace trust has blocked startup for over 20 seconds",
      "status": "waiting_external",
      "owner_attention": true
    },
    {
      "id": "consent_banner",
      "label": "Owner attention: Grok is asking whether to retain coding data (Help improve Grok) — only the owner may answer; no choice is sent automatically",
      "status": "waiting_external",
      "owner_attention": true
    },
    {
      "id": "approval_vanished",
      "label": "Approval clearing",
      "status": "approval"
    },
    {
      "id": "signing_in",
      "label": "Waiting for browser sign-in",
      "status": "waiting_external"
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "all": [
          {
            "elapsed_ms": 8000
          },
          {
            "any": [
              {
                "not": {
                  "section": "status_tail",
                  "matches": "(?:^|\\n)\\s*(?:Sign in to Grok Build\\b|Approve in your browser\\b|Waiting for approval\\.\\.\\.|Paste your xAI API key\\b|Enter your (?:xAI )?API key\\b)",
                  "flags": "i"
                }
              },
              {
                "section": "status_tail",
                "matches": "Shift\\+Tab:\\s*mode|Ctrl\\+x:\\s*shortcuts|(?:^|\\n)\\s*│\\s*❯(?:\\s|(?=\\n|$))",
                "flags": "i"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "→signing_in",
      "from": [
        "starting",
        "idle",
        "busy"
      ],
      "to": "signing_in",
      "priority": 130,
      "when": {
        "all": [
          {
            "section": "status_tail",
            "matches": "(?:^|\\n)\\s*(?:Sign in to Grok Build\\b|Approve in your browser\\b|Waiting for approval\\.\\.\\.|Paste your xAI API key\\b|Enter your (?:xAI )?API key\\b)",
            "flags": "i"
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "Shift\\+Tab:\\s*mode|Ctrl\\+x:\\s*shortcuts|(?:^|\\n)\\s*│\\s*❯(?:\\s|(?=\\n|$))",
              "flags": "i"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "\\[stop\\]|[\\u2800-\\u28ff]\\s+\\S[^\\n]*?\\b\\d+(?:\\.\\d+)?s\\b",
              "flags": "i"
            }
          },
          {
            "not": {
              "matches": "^\\s*Do you trust the contents of this directory\\?[\\s\\S]*?^\\s*Yes, proceed\\s+y\\s*$(?![\\s\\S]*^\\s*(?:Welcome to Grok CLI\\b|Sign in to Grok Build\\b|Approve in your browser\\b|Waiting for approval\\.\\.\\.|Paste your xAI API key\\b|Enter your (?:xAI )?API key\\b))",
              "flags": "im"
            }
          },
          {
            "not": {
              "matches": "Help improve Grok[\\s\\S]*?\\bOpt (?:out|in)\\b",
              "flags": "i"
            }
          },
          {
            "not": {
              "all": [
                {
                  "section": "footer",
                  "matches": "^\\s*\\d+/\\d+:select\\b",
                  "flags": "im"
                },
                {
                  "section": "modal",
                  "matches": "^\\s*(?:[┃❙|]\\s*)?1\\s*\\([●○]\\)\\s+(?!Sign in\\b|Paste your\\b)\\S[\\s\\S]*?^\\s*(?:[┃❙|]\\s*)?2\\s*\\([●○]\\)\\s+(?!Sign in\\b|Paste your\\b)\\S",
                  "flags": "im"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "label": "signing_in→idle",
      "from": "signing_in",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "status_tail",
              "matches": "\\[stop\\]|[\\u2800-\\u28ff]\\s+\\S[^\\n]*?\\b\\d+(?:\\.\\d+)?s\\b",
              "flags": "i"
            }
          },
          {
            "any": [
              {
                "section": "status_tail",
                "matches": "Shift\\+Tab:\\s*mode|Ctrl\\+x:\\s*shortcuts|(?:^|\\n)\\s*│\\s*❯(?:\\s|(?=\\n|$))",
                "flags": "i"
              },
              {
                "all": [
                  {
                    "elapsed_ms": 15000
                  },
                  {
                    "not": {
                      "section": "status_tail",
                      "matches": "(?:^|\\n)\\s*(?:Sign in to Grok Build\\b|Approve in your browser\\b|Waiting for approval\\.\\.\\.|Paste your xAI API key\\b|Enter your (?:xAI )?API key\\b)",
                      "flags": "i"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "label": "→consent_banner",
      "from": [
        "starting",
        "idle",
        "busy",
        "signing_in",
        "approval_vanished"
      ],
      "to": "consent_banner",
      "priority": 125,
      "when": {
        "all": [
          {
            "matches": "Help improve Grok",
            "flags": "i"
          },
          {
            "any": [
              {
                "matches": "\\bOpt out\\b",
                "flags": "i"
              },
              {
                "matches": "\\bOpt in\\b",
                "flags": "i"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "consent_banner→idle",
      "from": "consent_banner",
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "not": {
          "matches": "Help improve Grok",
          "flags": "i"
        }
      }
    },
    {
      "label": "→trust",
      "from": [
        "starting",
        "idle",
        "busy",
        "signing_in"
      ],
      "to": "trust",
      "priority": 120,
      "when": {
        "all": [
          {
            "matches": "Do you trust the contents of this directory\\?"
          },
          {
            "matches": "^\\s*Yes, proceed\\s+y\\s*$(?![\\s\\S]*^\\s*(?:Welcome to Grok CLI\\b|Sign in to Grok Build\\b|Approve in your browser\\b|Waiting for approval\\.\\.\\.|Paste your xAI API key\\b|Enter your (?:xAI )?API key\\b))",
            "flags": "im"
          }
        ]
      }
    },
    {
      "label": "trust→owner-attention",
      "from": "trust",
      "to": "trust_owner_attention",
      "priority": 110,
      "when": {
        "all": [
          {
            "elapsed_ms": 20001
          },
          {
            "matches": "Do you trust the contents of this directory\\?",
            "flags": "i"
          }
        ]
      }
    },
    {
      "label": "trust→idle",
      "from": [
        "trust",
        "trust_owner_attention"
      ],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "not": {
          "matches": "Do you trust the contents of this directory\\?"
        }
      }
    },
    {
      "label": "→approval",
      "from": [
        "starting",
        "signing_in",
        "idle",
        "busy",
        "approval_vanished"
      ],
      "to": "approval",
      "priority": 100,
      "when": {
        "all": [
          {
            "section": "footer",
            "matches": "^\\s*\\d+/\\d+:select\\b",
            "flags": "im"
          },
          {
            "section": "modal",
            "matches": "^\\s*(?:[┃❙|]\\s*)?1\\s*\\([●○]\\)\\s+(?!Sign in\\b|Paste your\\b)\\S[\\s\\S]*?^\\s*(?:[┃❙|]\\s*)?2\\s*\\([●○]\\)\\s+(?!Sign in\\b|Paste your\\b)\\S",
            "flags": "im"
          }
        ]
      }
    },
    {
      "label": "idle→busy",
      "from": [
        "starting",
        "signing_in",
        "idle"
      ],
      "to": "busy",
      "min_hold_ms": 700,
      "when": {
        "any": [
          {
            "matches": "[\\u2800-\\u28ff]\\s+\\S[^\\n]*?\\b\\d+(?:\\.\\d+)?s\\b",
            "flags": "im",
            "section": "status_tail"
          },
          {
            "matches": "\\[stop\\]",
            "section": "status_tail"
          },
          {
            "all": [
              {
                "matches": "Esc:cancel",
                "section": "footer"
              },
              {
                "not": {
                  "section": "footer",
                  "matches": "^\\s*\\d+/\\d+:select\\b",
                  "flags": "im"
                }
              },
              {
                "not": {
                  "section": "status_tail",
                  "matches": "^\\s*(?:Welcome to Grok CLI\\b|Sign in to Grok Build\\b|1\\s*\\([●○]\\)\\s+Sign in\\b|Paste your xAI API key\\b)[\\s\\S]*?^\\s*Esc:cancel\\b(?![^\\n]*│)",
                  "flags": "im"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 800,
      "when": {
        "all": [
          {
            "not": {
              "section": "status_tail",
              "matches": "[\\u2800-\\u28ff]\\s+\\S[^\\n]*?\\b\\d+(?:\\.\\d+)?s\\b",
              "flags": "im"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "\\[stop\\]"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "Esc:cancel"
            }
          },
          {
            "section": "footer",
            "matches": "Ctrl\\+x:shortcuts"
          },
          {
            "stable_ms": 2500,
            "ignore_lines": "^\\s*\\d+(?:\\.\\d+)?[KM]? / \\d+[KM]\\s*$|^\\s*Worked for \\d[^\\n]*$|^\\s*\\d{1,2}:\\d{2}\\s*[AP]M\\s*$"
          }
        ]
      }
    },
    {
      "label": "approval→vanished",
      "from": "approval",
      "to": "approval_vanished",
      "min_hold_ms": 400,
      "when": {
        "not": {
          "section": "footer",
          "matches": "^\\s*\\d+/\\d+:select\\b",
          "flags": "im"
        }
      }
    },
    {
      "label": "vanished→approval-returned",
      "from": "approval_vanished",
      "to": "approval",
      "priority": 90,
      "when": {
        "section": "footer",
        "matches": "^\\s*\\d+/\\d+:select\\b",
        "flags": "im"
      }
    },
    {
      "label": "vanished→busy",
      "from": "approval_vanished",
      "to": "busy",
      "min_hold_ms": 600,
      "when": {
        "any": [
          {
            "matches": "[\\u2800-\\u28ff]\\s+\\S[^\\n]*?\\b\\d+(?:\\.\\d+)?s\\b",
            "flags": "im",
            "section": "status_tail"
          },
          {
            "matches": "\\[stop\\]",
            "section": "status_tail"
          }
        ]
      }
    },
    {
      "label": "vanished→idle",
      "from": "approval_vanished",
      "to": "idle",
      "min_hold_ms": 1200,
      "when": {
        "all": [
          {
            "not": {
              "section": "footer",
              "matches": "^\\s*\\d+/\\d+:select\\b",
              "flags": "im"
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "\\[stop\\]"
            }
          },
          {
            "section": "footer",
            "matches": "Ctrl\\+x:shortcuts"
          }
        ]
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "cycle_mode",
      "label": "Mode",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b[Z"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path} "
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Grok Build",
      "body": "{state.title}"
    },
    {
      "id": "trust_needed",
      "when_state": "trust",
      "title": "Grok Build needs workspace trust",
      "body": "{state.title}"
    },
    {
      "id": "consent_owner_attention",
      "when_state": "consent_banner",
      "title": "Owner attention required in Grok Build",
      "body": "Grok is showing its 'Help improve Grok' data-retention consent banner. Answer it yourself in this session (the recorded owner decision is Opt out). No choice was sent automatically."
    },
    {
      "id": "trust_owner_attention",
      "when_state": "trust_owner_attention",
      "title": "Owner attention required in Grok Build",
      "body": "Workspace trust has blocked startup for over 20 seconds. Review the owner-registered repository and its trust decision in Grok. No trust choice was sent automatically."
    }
  ],
  "delegate": [],
  "native_history": {
    "reader": "grok-cli"
  }
}
