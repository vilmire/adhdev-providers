{
  "$schema": "adhdev:cli/spec@1",
  "id": "antigravity-cli",
  "name": "Antigravity CLI",
  "binary": "agy",
  "cli_version_range": ">=1.0.0",
  "spawn_args": [],
  "send_message": {
    "submit_key": "\r"
  },
  "debounce": {
    "busy_hold_ms": 5000,
    "startup_grace_ms": 15000
  },
  "layout": {
    "sections": [
      {
        "id": "footer",
        "from_bottom": 1
      },
      {
        "id": "modal_zone",
        "from_bottom": 24,
        "until": {
          "section": "footer"
        }
      },
      {
        "id": "body",
        "from_top": 0,
        "until": {
          "section": "modal_zone"
        }
      }
    ]
  },
  "states": [
    {
      "id": "trust_folder",
      "label": "Trust folder",
      "when": {
        "section": "modal_zone",
        "regex": "Do you trust the files in this folder\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Do you trust the files in this folder\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "trust_project",
      "label": "Trust project contents",
      "when": {
        "section": "modal_zone",
        "regex": "Do you trust the contents of this project\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Do you trust the contents of this project\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "when": {
        "section": "modal_zone",
        "regex": "Do you want to proceed\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(agy wants to run:[^\\n]+|Do you want to proceed\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "busy",
      "label": "Generating",
      "when": {
        "regex": "\\bThinking\\b|\\bRunning\\b|\\bUsing\\s+Tool\\b|\\bPrioritizing\\s+Tool\\b|[\\u2800-\\u28ff]|esc to cancel"
      }
    },
    {
      "id": "idle",
      "label": "Ready",
      "when": {
        "section": "footer",
        "regex": "\\? for shortcuts"
      }
    }
  ],
  "default_state": "idle",
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Antigravity",
      "body": "{state.title}"
    },
    {
      "id": "trust_folder_needed",
      "when_state": "trust_folder",
      "title": "Antigravity needs to trust this folder",
      "body": "{state.title}"
    },
    {
      "id": "trust_project_needed",
      "when_state": "trust_project",
      "title": "Antigravity needs to trust this project",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.gemini/antigravity-cli/brain/*/.system_generated/logs",
      "file_pattern": "transcript.jsonl",
      "recent_window_ms": 86400000,
      "message_filter": { "where": "$.type == 'USER_INPUT' || $.type == 'PLANNER_RESPONSE' && $.content != null" },
      "message_map": {
        "role": "$.source",
        "content": "$.content",
        "timestamp_ms": "$.created_at",
        "content_strip": ["ADDITIONAL_METADATA", "USER_SETTINGS_CHANGE"],
        "content_unwrap": ["USER_REQUEST"]
      }
    }
  }
}
