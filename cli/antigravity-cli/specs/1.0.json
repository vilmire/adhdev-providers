{
  "$schema": "adhdev:cli/spec@1",
  "id": "antigravity-cli",
  "name": "Antigravity CLI",
  "binary": "agy",
  "cli_version_range": ">=1.0.0",
  "spawn_args": [],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "debounce": {
    "busy_hold_ms": 5000,
    "idle_hold_ms": 1500,
    "startup_grace_ms": 15000
  },
  "layout": {
    "sections": [
      {
        "id": "footer",
        "from_bottom": 1
      },
      {
        "id": "modal_zone",
        "from_bottom": 24,
        "until": {
          "section": "footer"
        }
      },
      {
        "id": "body",
        "from_top": 0,
        "until": {
          "section": "modal_zone"
        }
      }
    ]
  },
  "states": [
    {
      "id": "trust_folder",
      "label": "Trust folder",
      "when": {
        "section": "modal_zone",
        "regex": "Do you trust the files in this folder\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Do you trust the files in this folder\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "trust_project",
      "label": "Trust project contents",
      "when": {
        "section": "modal_zone",
        "regex": "Do you trust the contents of this project\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Do you trust the contents of this project\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "when": {
        "section": "modal_zone",
        "regex": "Do you want to proceed\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(agy wants to run:[^\\n]+|Do you want to proceed\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r",
        "min_count": 2
      }
    },
    {
      "id": "idle",
      "label": "Ready",
      "when": {
        "section": "footer",
        "regex": "\\? for shortcuts"
      }
    },
    {
      "id": "signing_in",
      "label": "Signing in",
      "when": {
        "section": "body",
        "regex": "Signing in"
      }
    },
    {
      "id": "busy",
      "label": "Generating",
      "when": {
        "regex": "[\\u2800-\\u28ff]|esc to cancel"
      }
    }
  ],
  "default_state": "idle",
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u001b"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Antigravity",
      "body": "{state.title}"
    },
    {
      "id": "trust_folder_needed",
      "when_state": "trust_folder",
      "title": "Antigravity needs to trust this folder",
      "body": "{state.title}"
    },
    {
      "id": "trust_project_needed",
      "when_state": "trust_project",
      "title": "Antigravity needs to trust this project",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "_native_history_note": "MUST use the built-in `reader: antigravity-cli` (see specs/4.0.json). Antigravity stores conversations in per-session SQLite dbs (conversations/<uuid>.db, protobuf step_payload BLOBs) while brain transcript.jsonl is written empty; the declarative jsonl source surfaces 0 assistant messages + providerSessionId=null. The antigravity-cli reader decodes the .db and falls back to brain/.pb.",
  "native_history": {
    "reader": "antigravity-cli"
  }
}
