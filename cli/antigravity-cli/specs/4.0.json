{
  "$schema": "adhdev:cli/spec@4",
  "id": "antigravity-cli",
  "name": "Antigravity CLI",
  "binary": "agy",
  "cli_version_range": ">=1.0.0",
  "spawn_args": [],
  "send_on_spawn": ["\u001b[I"],
  "send_on_spawn_delay_ms": 250,
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "_sections_note": "MEASURED 2026-06-15 against agy 1.0.8 (Gemini 3.1 Pro). The old spec used positional windows: footer=from_bottom:1, modal=from_bottom:24 until:footer, body=from_top:0 until:modal, status=from_bottom:4 until:footer. Real screens proved two failures: (1) modal=from_bottom:24 is content junk — at idle (~11-line screen) it clamps to the whole banner+composer, and after a turn it is the response tail (e.g. 'We smoothly transition to twelve.'), so extract.title.first_line grabbed the wrong line (the echoed prompt '> Run this...') and buttons were polluted -> activeModal came back null. Fix: modal now anchors on its OWN landmark ('Do you want to proceed?' / 'Requesting permission for:') and runs to end-of-screen (no until). (2) body=from_top:0 until:modal starved to 0 lines whenever the screen is short (idle + early generating), so every body braille check was dead. Fix: body is the whole screen. The footer anchor '? for shortcuts' / 'esc to cancel' DID match live and is kept.",
  "sections": {
    "footer": {
      "from_bottom": 1
    },
    "modal": {
      "anchor": "Do you trust the files in this folder\\?|Do you trust the contents of this project\\?|Requesting permission for:|Do you want to proceed\\?",
      "anchor_last": true
    },
    "body": {
      "from_top": 0
    }
  },
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "signing_in",
      "label": "Signing in",
      "status": "generating"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Generating",
      "status": "generating"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "trust",
      "label": "Trust required",
      "modal": true,
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[>›]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    }
  ],
  "transitions": [
    {
      "label": "starting→idle-ready",
      "from": "starting",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "body",
              "matches": "Signing in"
            }
          },
          {
            "section": "footer",
            "matches": "\\? for shortcuts"
          }
        ]
      }
    },
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "elapsed_ms": 15000
      }
    },
    {
      "label": "starting→signing_in",
      "from": "starting",
      "to": "signing_in",
      "when": {
        "section": "body",
        "matches": "Signing in"
      }
    },
    {
      "label": "signing_in→idle",
      "from": "signing_in",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "body",
              "matches": "Signing in"
            }
          },
          {
            "section": "footer",
            "matches": "\\? for shortcuts"
          }
        ]
      }
    },
    {
      "label": "→trust",
      "from": ["starting", "idle", "busy"],
      "to": "trust",
      "priority": 110,
      "when": {
        "section": "modal",
        "matches": "Do you trust the files in this folder\\?|Do you trust the contents of this project\\?"
      }
    },
    {
      "label": "→approval",
      "from": ["starting", "idle", "busy"],
      "to": "approval",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Do you want to proceed\\?|Requesting permission for:"
      }
    },
    {
      "label": "idle→busy",
      "from": "idle",
      "to": "busy",
      "when": {
        "any": [
          {
            "section": "body",
            "matches": "[\\u2800-\\u28ff]\\s+(?:Generating|Running|Thinking)"
          },
          {
            "section": "footer",
            "matches": "esc to cancel"
          }
        ]
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Do you want to proceed\\?|Requesting permission for:"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "esc to cancel"
            }
          },
          {
            "section": "footer",
            "matches": "\\? for shortcuts"
          },
          {
            "stable_ms": 1500,
            "cursor_above": 4
          }
        ]
      }
    },
    {
      "label": "approval→busy",
      "from": ["approval", "trust"],
      "to": "busy",
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Do you want to proceed\\?|Requesting permission for:"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Do you trust the files in this folder\\?|Do you trust the contents of this project\\?"
            }
          },
          {
            "any": [
              {
                "section": "body",
                "matches": "[\\u2800-\\u28ff]\\s+(?:Generating|Running|Thinking)"
              },
              {
                "section": "footer",
                "matches": "esc to cancel"
              }
            ]
          }
        ]
      }
    },
    {
      "label": "approval→idle",
      "from": ["approval", "trust"],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Do you want to proceed\\?|Requesting permission for:"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Do you trust the files in this folder\\?|Do you trust the contents of this project\\?"
            }
          },
          {
            "not": {
              "section": "footer",
              "matches": "esc to cancel"
            }
          },
          {
            "section": "footer",
            "matches": "\\? for shortcuts"
          }
        ]
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": ["busy"],
      "action": {
        "type": "send_keys",
        "keys": "\u001b"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Antigravity",
      "body": "{state.title}"
    },
    {
      "id": "trust_needed",
      "when_state": "trust",
      "title": "Antigravity needs to trust this folder",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.gemini/antigravity-cli/brain/*/.system_generated/logs",
      "file_pattern": "transcript.jsonl",
      "recent_window_ms": 86400000,
      "message_filter": {
        "where": "$.type == 'USER_INPUT' || $.type == 'PLANNER_RESPONSE' && $.content != null"
      },
      "message_map": {
        "role": "$.source",
        "content": "$.content",
        "timestamp_ms": "$.created_at",
        "content_strip": ["ADDITIONAL_METADATA", "USER_SETTINGS_CHANGE"],
        "content_unwrap": ["USER_REQUEST"]
      }
    }
  }
}
