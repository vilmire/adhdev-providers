{
  "type": "antigravity-cli",
  "name": "Antigravity CLI",
  "category": "cli",
  "aliases": [
    "agy"
  ],
  "icon": "🪐",
  "displayName": "Antigravity CLI",
  "binary": "agy",
  "versionCommand": "agy --version",
  "sendDelayMs": 500,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requirePromptEchoBeforeSubmit": true,
  "approvalKeys": {
    "3": "0\r"
  },
  "approvalPositiveHints": [
    "yes",
    "allow once",
    "approve",
    "accept",
    "continue",
    "run",
    "proceed",
    "confirm",
    "trust",
    "allow"
  ],
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "spawn": {
    "command": "bash",
    "args": [
      "-c",
      "_agy_ws=\"{{workingDir}}\"; _agy_real=\"$(cd \"$_agy_ws\" 2>/dev/null && pwd -P || printf '%s' \"$_agy_ws\")\"; case \"$_agy_real\" in */.*) _agy_link=\"$(mktemp -d)/adhdev-agy-ws\" && ln -sfn \"$_agy_real\" \"$_agy_link\" && cd \"$_agy_link\" ;; *) cd \"$_agy_real\" ;; esac && exec agy"
    ],
    "shell": false,
    "env": {}
  },
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "resumeArgs": [
      "--continue"
    ]
  },
  "defaultScriptDir": "scripts/1.0",
  "compatibility": [
    {
      "ideVersion": ">=1.0.0",
      "scriptDir": "scripts/1.0"
    }
  ],
  "status": "Beta",
  "details": "Terminal only",
  "providerVersion": "1.0.0",
  "contractVersion": 2,
  "capabilities": {
    "input": {
      "multipart": false,
      "mediaTypes": [
        "text"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": false
    }
  },
  "canonicalHistory": {
    "format": "antigravity-cli-transcript-jsonl",
    "watchPath": "~/.gemini/antigravity-cli/history.jsonl;~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript*.jsonl;~/.gemini/antigravity-cli/conversations/*.pb",
    "mode": "native-source",
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  }
}
