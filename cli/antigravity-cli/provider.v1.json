{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "antigravity-cli",
  "name": "Antigravity CLI",
  "displayName": "Antigravity CLI",
  "category": "cli",
  "aliases": [
    "agy"
  ],
  "icon": "🪐",
  "status": "Beta",
  "details": "Terminal only",
  "links": {
    "homepage": "https://antigravity.google",
    "docs": "https://antigravity.google/docs"
  },
  "install": {
    "manual": "Download the Antigravity client from antigravity.google. The agy CLI is bundled with the desktop app."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.1.4",
  "binary": "agy",
  "versionCommand": "agy --version",
  "sendDelayMs": 500,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requirePromptEchoBeforeSubmit": true,
  "approvalKeys": {
    "3": "0\r"
  },
  "approvalPositiveHints": [
    "yes",
    "allow once",
    "approve",
    "accept",
    "continue",
    "run",
    "proceed",
    "confirm",
    "trust",
    "allow"
  ],
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "spawn": {
    "command": "bash",
    "args": [
      "-c",
      "_agy_ws=\"{{workingDir}}\"; _agy_real=\"$(cd \"$_agy_ws\" 2>/dev/null && pwd -P || printf '%s' \"$_agy_ws\")\"; case \"$_agy_real\" in */.*) _agy_link=\"$(mktemp -d)/adhdev-agy-ws\" && ln -sfn \"$_agy_real\" \"$_agy_link\" && cd \"$_agy_link\" ;; *) cd \"$_agy_real\" ;; esac && exec agy"
    ],
    "shell": false
  },
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "resumeArgs": [
      "--continue"
    ]
  },
  "compatibility": [
    {
      "ideVersion": ">=1.0.0",
      "scriptDir": "scripts/1.0"
    }
  ],
  "defaultScriptDir": "scripts/1.0",
  "tui": {
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "\\bThinking\\b",
          "flags": "i"
        },
        {
          "regex": "\\bRunning\\b",
          "flags": "i"
        },
        {
          "regex": "\\bUsing\\s+Tool\\b",
          "flags": "i"
        },
        {
          "regex": "\\bPrioritizing\\s+Tool\\b",
          "flags": "i"
        },
        {
          "regex": "[\\u2800-\\u28ff]",
          "description": "Braille spinner; restricted by scope to the live frame to avoid scrollback braille from tool output"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 8
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "^>\\s*$",
      "flags": "m",
      "withFooter": [
        {
          "pattern": "? for shortcuts"
        }
      ],
      "scope": "last-n-lines",
      "scopeWindowLines": 8
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Do you trust the files in this folder\\?|Do you trust the contents of this project\\?|Do you want to proceed\\?",
      "questionFlags": "i",
      "buttonPattern": "^>?\\s*\\d+\\.\\s+(.+)$",
      "buttonFlags": "m",
      "inlineButtonPattern": "\\[\\d+\\]\\s+([^\\[]+?)(?=\\s+\\[\\d+\\]|$)",
      "inlineButtonFlags": "gi",
      "contextHeader": {
        "regex": "agy wants to run:\\s*([^\\n]+)",
        "flags": "i"
      },
      "continuationLines": true,
      "scope": "window-around-question",
      "scopeWindowLines": 16,
      "minButtons": 2
    },
    "visibleRegion": {
      "$schema": "adhdev:tui/visible-region@1",
      "scope": "between-anchors",
      "anchors": {
        "top": {
          "pattern": "─{40,}\\s*\\n\\s*>\\s*",
          "flags": "m"
        },
        "bottom": {
          "pattern": "─{40,}\\s*$",
          "flags": "m"
        }
      },
      "selectAnchor": "last",
      "stripCues": [
        "adhdev:tui/footer-chrome@1",
        "adhdev:tui/welcome-screen@1"
      ]
    },
    "welcomeScreen": {
      "$schema": "adhdev:tui/welcome-screen@1",
      "cues": [
        {
          "pattern": "how's the cli experience so far\\?",
          "flags": "i"
        },
        {
          "pattern": "\\[0\\]\\s+skip",
          "flags": "i"
        }
      ],
      "dismissAfter": {
        "onPromptMarker": true,
        "onUserEcho": true
      }
    },
    "errorDetection": {
      "$schema": "adhdev:tui/error-detection@1",
      "patterns": [
        {
          "regex": "servers?\\s+are\\s+experiencing\\s+high\\s+traffic",
          "flags": "i",
          "verdict": "error"
        }
      ]
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt",
        "error-detection"
      ],
      "onNoMatch": "preserve-last"
    }
  },
  "nativeHistory": {
    "$schema": "adhdev:native-history/anthropic-cli-transcript@1",
    "format": "antigravity-cli-transcript-jsonl",
    "watchPath": "~/.gemini/antigravity-cli/history.jsonl;~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript*.jsonl;~/.gemini/antigravity-cli/conversations/*.pb",
    "mode": "native-source",
    "contractVersion": "2.0",
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  },
  "settings": {
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": false
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "manual",
      "serverName": "adhdev-mesh",
      "requiresRestart": true,
      "instructions": "ADHDev will register the adhdev-mesh MCP server in Antigravity CLI via `agy mcp add` before launching a fresh coordinator session. You can verify with `agy mcp list`.",
      "template": "agy mcp add {{serverName}} -- {{adhdevMcpCommand}} mcp --mode ipc --repo-mesh {{meshId}}"
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  },
  "canonicalHistory": {
    "format": "antigravity-cli-transcript-jsonl",
    "watchPath": "~/.gemini/antigravity-cli/history.jsonl;~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript*.jsonl;~/.gemini/antigravity-cli/conversations/*.pb",
    "mode": "native-source",
    "contractVersion": "2.0",
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  }
}
