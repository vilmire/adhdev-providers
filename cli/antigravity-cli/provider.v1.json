{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "antigravity-cli",
  "name": "Antigravity CLI",
  "displayName": "Antigravity CLI",
  "category": "cli",
  "aliases": [
    "agy"
  ],
  "icon": "🪐",
  "status": "Beta",
  "details": "Terminal only",
  "links": {
    "homepage": "https://antigravity.google",
    "docs": "https://antigravity.google/docs"
  },
  "install": {
    "manual": "Download the Antigravity client from antigravity.google. The agy CLI is bundled with the desktop app."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.2.6",
  "binary": "agy",
  "versionCommand": "agy --version",
  "sendDelayMs": 500,
  "sendKey": "\r",
  "submitStrategy": "wait_for_echo",
  "requirePromptEchoBeforeSubmit": true,
  "holdCompletionForTranscript": true,
  "approvalKeys": {
    "3": "0\r"
  },
  "approvalPositiveHints": [
    "yes",
    "allow once",
    "approve",
    "accept",
    "continue",
    "run",
    "proceed",
    "confirm",
    "trust",
    "allow"
  ],
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "spawn": {
    "command": "bash",
    "args": [
      "-c",
      "_agy_ws=\"{{workingDir}}\"; _agy_real=\"$(cd \"$_agy_ws\" 2>/dev/null && pwd -P || printf '%s' \"$_agy_ws\")\"; case \"$_agy_real\" in */.*) _agy_link=\"$(mktemp -d)/adhdev-agy-ws\" && ln -sfn \"$_agy_real\" \"$_agy_link\" && cd \"$_agy_link\" ;; *) cd \"$_agy_real\" ;; esac && exec agy"
    ],
    "shell": false
  },
  "modelLaunchArgs": [
    "--model",
    "{{model}}"
  ],
  "modelOptions": [
    "Gemini 3.7 Flash (High)",
    "Gemini 3.7 Flash (Medium)",
    "Gemini 3.7 Flash (Low)",
    "Gemini 3.5 Flash (Medium)",
    "Gemini 3.5 Flash (High)",
    "Gemini 3.5 Flash (Low)",
    "Gemini 3.1 Pro (Low)",
    "Gemini 3.1 Pro (High)",
    "Claude Sonnet 4.6 (Thinking)",
    "Claude Opus 4.6 (Thinking)",
    "GPT-OSS 120B (Medium)"
  ],
  "resume": {
    "supported": true,
    "stopStrategy": "ctrl_c",
    "shutdownGraceMs": 4000,
    "resumeArgs": [
      "--continue"
    ]
  },
  "compatibility": [
    {
      "ideVersion": ">=1.0.0",
      "spec": "specs/4.0.json"
    }
  ],
  "nativeHistory": {
    "$schema": "adhdev:native-history/anthropic-cli-transcript@1",
    "format": "antigravity-cli-transcript-jsonl",
    "watchPath": "~/.gemini/antigravity-cli/history.jsonl;~/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript*.jsonl;~/.gemini/antigravity-cli/conversations/*.pb;~/.gemini/antigravity-cli/conversations/*.db",
    "mode": "native-source",
    "contractVersion": "2.0",
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  },
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the mesh coordinator system prompt as a chat message. Off by default — the prompt is still visible via the chat header's ⓘ Session Info dialog."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": false
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "auto_import",
      "format": "claude_mcp_json",
      "path": "~/.gemini/config/mcp_config.json",
      "serverName": "adhdev-mesh"
    },
    "systemPromptInjection": {
      "mode": "context_file",
      "path": "AGENTS.md",
      "wrapper": "<!-- adhdev-mesh-coordinator-prompt -->\n{prompt}\n<!-- /adhdev-mesh-coordinator-prompt -->"
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
