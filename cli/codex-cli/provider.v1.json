{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "codex-cli",
  "name": "Codex CLI",
  "displayName": "Codex CLI",
  "category": "cli",
  "aliases": [
    "codex"
  ],
  "icon": "🧠",
  "status": "Stable",
  "details": "Terminal only",
  "links": {
    "homepage": "https://openai.com/index/introducing-codex/",
    "repo": "https://github.com/openai/codex",
    "docs": "https://github.com/openai/codex#readme"
  },
  "install": {
    "npm": "npm install -g @openai/codex",
    "manual": "Then run `codex login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.1.1",
  "binary": "codex",
  "spawn": {
    "command": "codex",
    "args": [
      "--dangerously-bypass-approvals-and-sandbox"
    ],
    "shell": false
  },
  "sendDelayMs": 1200,
  "sendKey": "\r\n",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "command",
    "stopCommand": "exit",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "uuid",
    "resumeSessionArgs": [
      "resume",
      "{{id}}"
    ],
    "resumeArgs": [
      "resume",
      "--last"
    ]
  },
  "compatibility": [
    {
      "ideVersion": ">=0.137.0",
      "scriptDir": "scripts/v1",
      "spec": "specs/0.137.json"
    },
    {
      "ideVersion": ">=0.42.0",
      "scriptDir": "scripts/v1"
    }
  ],
  "defaultScriptDir": "scripts/v1",
  "tui": {
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "Working \\((?:\\d+h\\s+\\d+m\\s+\\d+s|\\d+m\\s+\\d+s|\\d+s)",
          "flags": "i",
          "description": "Codex elapsed-time Working line"
        },
        {
          "regex": "esc to (?:cancel|interrupt|stop)",
          "flags": "i"
        },
        {
          "regex": "Starting MCP servers \\(",
          "flags": "i",
          "description": "Codex MCP boot spinner"
        },
        {
          "regex": "[\\u2800-\\u28ff]",
          "description": "Braille spinner"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 12
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "^[›❯>]\\s*$",
      "flags": "m",
      "withFooter": [
        {
          "pattern": "? for shortcuts"
        },
        {
          "pattern": "tab to queue message"
        }
      ],
      "scope": "last-n-lines",
      "scopeWindowLines": 12
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Do you trust the contents of this directory|Allow Codex to (?:run|apply)|Allow command\\?|Approve and run now|Always approve this session|Approaching rate limits",
      "questionFlags": "i",
      "questionVariants": [
        {
          "regex": "Switch to gpt-[\\w.-]+ for lower credit usage",
          "flags": "i",
          "label": "rate-limit-switch"
        },
        {
          "regex": "Update available!",
          "flags": "i",
          "label": "update-prompt"
        }
      ],
      "buttonPattern": "^[\\s❯>▌]*\\d+\\.\\s+(.+)$",
      "buttonFlags": "m",
      "scope": "between-last-two-separators"
    },
    "approvalSquash": {
      "$schema": "adhdev:tui/approval-squash@1",
      "cues": [
        {
          "compact": "doyoutrustthecontentsofthisdirectory",
          "label": "trust-folder",
          "messageWhenMatched": "Do you trust the contents of this directory?"
        },
        {
          "compact": "workingwithuntrustedcontents",
          "label": "untrusted-content",
          "messageWhenMatched": "Working with untrusted contents"
        },
        {
          "compact": "switchtogpt",
          "kind": "regex",
          "label": "rate-limit",
          "messageWhenMatched": "Approaching rate limits"
        },
        {
          "compact": "allowcodextorun",
          "label": "allow-run",
          "messageWhenMatched": "Allow Codex to run this command?"
        },
        {
          "compact": "allowcodextoapply",
          "label": "allow-apply",
          "messageWhenMatched": "Allow Codex to apply this change?"
        },
        {
          "compact": "allowcommand",
          "label": "allow-command",
          "messageWhenMatched": "Allow command?"
        }
      ],
      "footers": [
        {
          "compact": "pressentertocontinue"
        },
        {
          "compact": "esctocancel"
        }
      ],
      "buttonRules": [
        {
          "compact": "1yescontinue2noquit",
          "labels": [
            "Yes, continue",
            "No, quit"
          ]
        },
        {
          "compact": "1approveandrun2deny",
          "labels": [
            "Approve and run",
            "Deny"
          ]
        },
        {
          "compact": "1alwaysapprove2approve3deny",
          "labels": [
            "Always approve",
            "Approve",
            "Deny"
          ]
        }
      ],
      "scope": "tail-window",
      "tailWindowLines": 24
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt"
      ],
      "onNoMatch": "idle"
    },
    "transcriptPty": {
      "$schema": "adhdev:tui/transcript-pty@1",
      "assistantPrefix": {
        "regex": "^[>•]\\s+(.*)$"
      },
      "userPrefix": {
        "regex": "^[▌›❯]\\s+(.*)$"
      },
      "chromePatterns": [
        {
          "regex": "^>_\\s+OpenAI Codex",
          "flags": "i"
        },
        {
          "regex": "^Tip:",
          "flags": "i"
        },
        {
          "regex": "^Starting MCP servers?",
          "flags": "i"
        },
        {
          "regex": "esc to interrupt",
          "flags": "i"
        },
        {
          "regex": "^[─═╭╮╰╯│┌┐└┘├┤┬┴┼]+",
          "label": "box-drawing"
        },
        {
          "regex": "model:\\s+",
          "flags": "i"
        },
        {
          "regex": "directory:\\s+",
          "flags": "i"
        },
        {
          "regex": "permissions:\\s+",
          "flags": "i"
        },
        {
          "regex": "^[▌›❯>]\\s*$",
          "label": "standalone-prompt-marker"
        },
        {
          "regex": "^(?:gpt-|o\\d|codex-)[\\w._-]+(?:\\s+(?:none|minimal|low|medium|high|xhigh|max|fast))?\\s+·",
          "flags": "i",
          "label": "model-footer"
        },
        {
          "regex": "^Find and fix a bug in @filename|^Improve documentation in @filename|^Write tests for @filename|^Explain this codebase|^Summarize recent commits|^Implement \\{feature\\}|^Use /skills|^Run /review on my current changes",
          "flags": "i",
          "label": "starter-prompt-suggestion"
        }
      ],
      "scope": "buffer"
    }
  },
  "nativeHistory": {
    "$schema": "adhdev:native-history/codex-rollout@1",
    "format": "codex-rollout",
    "watchPath": "~/.codex/sessions",
    "mode": "native-source",
    "contractVersion": "1.0",
    "spawnGraceMs": 3000,
    "excludeInProgressTurn": true,
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  },
  "overrides": {},
  "settings": {
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "manual",
      "serverName": "adhdev-mesh",
      "requiresRestart": true,
      "instructions": "ADHDev will register the adhdev-mesh MCP server in Codex via `codex mcp add` before launching a fresh coordinator session. You can verify with `codex mcp list`.",
      "template": "codex mcp add {{serverName}} -- {{adhdevMcpCommand}} mcp --mode ipc --repo-mesh {{meshId}}"
    },
    "systemPromptInjection": {
      "mode": "config_override",
      "flag": "-c",
      "template": "developer_instructions={prompt_json}"
    }
  }
}
