{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "codex-cli",
  "name": "Codex CLI",
  "displayName": "Codex CLI",
  "category": "cli",
  "aliases": [
    "codex"
  ],
  "icon": "🧠",
  "status": "Stable",
  "details": "Terminal only",
  "links": {
    "homepage": "https://openai.com/index/introducing-codex/",
    "repo": "https://github.com/openai/codex",
    "docs": "https://github.com/openai/codex#readme"
  },
  "install": {
    "npm": "npm install -g @openai/codex",
    "manual": "Then run `codex login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.1.14",
  "binary": "codex",
  "spawn": {
    "command": "codex",
    "args": [
      "--dangerously-bypass-approvals-and-sandbox"
    ],
    "shell": false
  },
  "sendDelayMs": 1200,
  "sendKey": "\r\n",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "command",
    "stopCommand": "exit",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "uuid",
    "resumeSessionArgs": [
      "resume",
      "{{id}}"
    ],
    "resumeArgs": [
      "resume",
      "--last"
    ]
  },
  "compatibility": [
    {
      "ideVersion": ">=0.137.0",
      "spec": "specs/0.137.json"
    },
    {
      "ideVersion": ">=0.42.0"
    }
  ],
  "nativeHistory": {
    "$schema": "adhdev:native-history/codex-rollout@1",
    "format": "codex-rollout",
    "watchPath": "~/.codex/sessions",
    "mode": "native-source",
    "contractVersion": "1.0",
    "spawnGraceMs": 3000,
    "excludeInProgressTurn": true,
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  },
  "overrides": {},
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the AGENTS.md / developer_instructions block as a user-role message in the chat. Off by default — the prompt is still visible via the chat header's ⓘ Session Info dialog."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "manual",
      "serverName": "adhdev-mesh",
      "requiresRestart": true,
      "instructions": "ADHDev will register the adhdev-mesh MCP server in Codex via `codex mcp add` before launching a fresh coordinator session. You can verify with `codex mcp list`.",
      "template": "codex mcp add {{serverName}} -- {{adhdevMcpCommand}} mcp --mode ipc --repo-mesh {{meshId}}"
    },
    "systemPromptInjection": {
      "mode": "config_override",
      "flag": "-c",
      "template": "developer_instructions={prompt_json}"
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
