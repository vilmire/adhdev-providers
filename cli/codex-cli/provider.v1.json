{
  "$schema": "https://registry.adhf.dev/schemas/v1/cli/provider.schema.json",
  "type": "codex-cli",
  "name": "Codex CLI",
  "displayName": "Codex CLI",
  "category": "cli",
  "aliases": [
    "codex"
  ],
  "icon": "🧠",
  "status": "Stable",
  "details": "Terminal only",
  "links": {
    "homepage": "https://openai.com/index/introducing-codex/",
    "repo": "https://github.com/openai/codex",
    "docs": "https://github.com/openai/codex#readme"
  },
  "install": {
    "npm": "npm install -g @openai/codex",
    "manual": "Then run `codex login` to authenticate."
  },
  "engines": {
    "adhdev": "^1.0.0"
  },
  "providerVersion": "1.1.16",
  "binary": "codex",
  "spawn": {
    "command": "codex",
    "args": [],
    "shell": false
  },
  "modelLaunchArgs": [
    "-c",
    "model={{model}}"
  ],
  "modelOptions": [
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna",
    "gpt-5.5",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5-codex",
    "gpt-5-codex-mini"
  ],
  "thinkingLaunchArgs": [
    "-c",
    "model_reasoning_effort={{level}}"
  ],
  "thinkingLevelMap": {
    "low": "low",
    "medium": "medium",
    "high": "high"
  },
  "thinkingLevelOptions": [
    "minimal",
    "low",
    "medium",
    "high",
    "xhigh"
  ],
  "sendDelayMs": 1200,
  "sendKey": "\r\n",
  "submitStrategy": "wait_for_echo",
  "requiresFinalAssistantBeforeIdle": true,
  "timeouts": {
    "idleFinishConfirm": 5000,
    "statusActivityHold": 5000
  },
  "resume": {
    "supported": true,
    "stopStrategy": "command",
    "stopCommand": "exit",
    "shutdownGraceMs": 4000,
    "sessionIdFormat": "uuid",
    "resumeSessionArgs": [
      "resume",
      "{{id}}"
    ],
    "resumeArgs": [
      "resume",
      "--last"
    ]
  },
  "compatibility": [
    {
      "ideVersion": ">=0.137.0",
      "spec": "specs/4.0.json"
    },
    {
      "ideVersion": ">=0.42.0"
    }
  ],
  "tui": {
    "spinner": {
      "$schema": "adhdev:tui/spinner@1",
      "patterns": [
        {
          "regex": "Working \\("
        },
        {
          "regex": "Starting MCP servers \\("
        },
        {
          "regex": "esc to interrupt",
          "flags": "i"
        }
      ],
      "scope": "live-frame-tail",
      "scopeWindowLines": 12
    },
    "settledPrompt": {
      "$schema": "adhdev:tui/settled-prompt@1",
      "regex": "^[❯›>]\\s*$",
      "flags": "m",
      "withFooter": [
        {
          "pattern": "? for shortcuts"
        },
        {
          "pattern": "tab to queue message"
        }
      ],
      "scope": "last-n-lines",
      "scopeWindowLines": 12
    },
    "modal": {
      "$schema": "adhdev:tui/modal@1",
      "questionPattern": "Would you like to run the following command\\?|Allow command\\?|Allow Codex to|Allow the .+ MCP server to run tool|Do you trust the contents of this directory\\?|Approaching rate limits|Switch to .+ for lower credit usage",
      "questionFlags": "i",
      "questionVariants": [
        {
          "regex": "enter to submit \\| esc to cancel",
          "flags": "i",
          "label": "submit-footer"
        }
      ],
      "buttonPattern": "^\\s*([❯›>]\\s*)?\\d+[.)]\\s+(.+)$",
      "buttonLabelGroup": 2,
      "buttonFlags": "m",
      "scope": "window-around-question",
      "scopeWindowLines": 36,
      "continuationLines": true
    },
    "approvalSquash": {
      "$schema": "adhdev:tui/approval-squash@1",
      "cues": [
        {
          "compact": "doyoutrustthecontentsofthisdirectory",
          "messageWhenMatched": "Do you trust the contents of this directory?"
        },
        {
          "compact": "approachingratelimits",
          "messageWhenMatched": "Approaching rate limits"
        }
      ],
      "footers": [
        {
          "compact": "pressentertocontinue"
        }
      ],
      "buttonRules": [
        {
          "compact": "1yescontinue2noquit",
          "labels": [
            "Yes, continue",
            "No, quit"
          ]
        },
        {
          "compact": "1approveandrun2deny",
          "labels": [
            "Approve and run",
            "Deny"
          ]
        }
      ],
      "scope": "tail-window",
      "tailWindowLines": 24
    },
    "dispatchOrder": {
      "$schema": "adhdev:tui/dispatch-order@1",
      "order": [
        "modal",
        "spinner",
        "settled-prompt"
      ],
      "onNoMatch": "preserve-last"
    }
  },
  "nativeHistory": {
    "$schema": "adhdev:native-history/codex-rollout@1",
    "format": "codex-rollout",
    "watchPath": "~/.codex/sessions",
    "mode": "native-source",
    "contractVersion": "1.0",
    "spawnGraceMs": 3000,
    "excludeInProgressTurn": true,
    "scripts": {
      "readSession": "readNativeHistory",
      "listSessions": "listNativeHistory"
    }
  },
  "overrides": {},
  "settings": {
    "showCoordinatorSystemPrompt": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Show system prompt message",
      "description": "Show the AGENTS.md / developer_instructions block as a user-role message in the chat. Off by default — the prompt is still visible via the chat header's ⓘ Session Info dialog."
    },
    "notifications": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Notifications",
      "description": "Display notifications on state changes"
    },
    "autoApprove": {
      "type": "boolean",
      "default": false,
      "public": true,
      "label": "Auto Approve",
      "description": "Automatically approve all tool calls"
    },
    "approvalAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Approval Notifications",
      "description": "Show notification when approval is needed"
    },
    "longGeneratingAlert": {
      "type": "boolean",
      "default": true,
      "public": true,
      "label": "Long Generation Alert",
      "description": "Alert when generation takes too long"
    },
    "longGeneratingThresholdSec": {
      "type": "number",
      "default": 180,
      "public": true,
      "label": "Long Generation Threshold (sec)",
      "min": 30,
      "max": 600
    }
  },
  "capabilities": {
    "input": {
      "multipart": true,
      "mediaTypes": [
        "text",
        "image"
      ]
    },
    "output": {
      "richContent": false,
      "mediaTypes": [
        "text"
      ]
    },
    "controls": {
      "typedResults": true
    }
  },
  "meshCoordinator": {
    "supported": true,
    "mcpConfig": {
      "mode": "manual",
      "serverName": "adhdev-mesh",
      "requiresRestart": true,
      "instructions": "ADHDev will register the adhdev-mesh MCP server in Codex via `codex mcp add` before launching a fresh coordinator session. You can verify with `codex mcp list`.",
      "template": "codex mcp add {{serverName}} -- {{adhdevMcpCommand}} {{adhdevMcpArgs}}"
    },
    "systemPromptInjection": {
      "mode": "config_override",
      "flag": "-c",
      "template": "developer_instructions={prompt_json}"
    },
    "delegatedWorkerIsolation": {
      "args": [
        {
          "mode": "config_override",
          "flag": "-c",
          "key": "mcp_servers.adhdev-mesh.enabled",
          "value": "false",
          "dedupeKey": "mcp_servers.adhdev-mesh"
        }
      ]
    }
  },
  "source": {
    "type": "github",
    "repo": "vilmire/adhdev-providers",
    "ref": "main"
  }
}
