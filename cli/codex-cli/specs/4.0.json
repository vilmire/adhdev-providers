{
  "$schema": "adhdev:cli/spec@4",
  "id": "codex-cli",
  "name": "Codex CLI",
  "binary": "codex",
  "cli_version_range": ">=0.137.0",
  "spawn_args": [],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "_sections_note": "MEASURED against live codex 0.139.0 (2026-06-15). The old footer anchor (tab to queue message|⏎ send|^[›>]$) matched NOTHING this codex renders, so footer defaulted to the whole screen and every `until: footer` section (modal/body/options/status) collapsed to EMPTY — the FSM could never see the approval modal or the Working spinner and sat in idle forever. The modal section now anchors directly on its own landmark with NO `until` (the guard regexes are modal-specific, so a whole-screen fallback in non-modal frames is harmless). body is the whole screen (Working/esc-to-interrupt only appear while generating). See docs/guides/CLI_SPEC_MEASURED_REWRITE.md.",
  "sections": {
    "modal": {
      "anchor": "Do you trust the contents of this directory\\?|Would you like to run the following command\\?|Allow command\\?|Allow Codex to|Allow the .+ MCP server to run tool|enter to submit \\| esc to cancel|Press enter to confirm or esc to cancel|Select a model|switch to a different model"
    },
    "composer": {
      "anchor": "^›\\s",
      "anchor_last": true,
      "lines": 1
    },
    "body": {
      "from_top": 0
    },
    "status_tail": {
      "anchor": "^›\\s",
      "anchor_last": true,
      "above": 12,
      "anchor_miss": "empty"
    }
  },
  "_statustail_note": "STATUS-TAIL-REANCHOR (CODEX-FSM-DEGENERATE-STABLE RCA, defect 1). status_tail used to be a landmark-less from_bottom:12, but the FSM's viewport snapshot is blank-trimmed (ghostty-vt-backend getText → trimBlankEnds), so from_bottom counts from the LAST NON-BLANK line, not the terminal bottom — on long output the 12-line window filled with body text and the live `Working (…)` spinner escaped ABOVE it, so busy→idle's not-clause read 'no spinner' while the worker was still generating (live: false generating_completed at duration=402s). The section is now anchored on the composer landmark (`^›\\s`, anchor_last — the same anchor the `composer` section uses) and extends 12 lines ABOVE it (`above`), so the window pins to the live status block regardless of output volume. `anchor_miss: empty` resolves the section to EMPTY on frames where the composer is momentarily absent (mid-redraw) instead of the whole-screen fallback — a whole-screen status_tail would re-open SPINNER-BODY-SELFMATCH (assistant prose quoting `esc to interrupt` matching the busy cue). NOT a return to whole-screen `body`: the window stays narrow and landmark-fixed.",
  "_selfmatch_note": "SPINNER-BODY-SELFMATCH fix (sibling of the claude-cli rc.6 status_tail anchoring). The busy cues `Working (` / `esc to interrupt` used to be checked as unanchored literals against the whole-screen `body` section. When an assistant answer quoted or explained those strings (an RCA about codex's own spinner), the body self-matched → idle→busy false-fired and busy→idle's not-clause read TRUE forever → infinite generating. The fix scopes every busy-cue check to `status_tail` (from_bottom:12 — the same live status/prompt window codex's tui.settledPrompt already trusts, scopeWindowLines:12) and anchors the cue on codex's animated-spinner shape: `Working (`/`Thinking (` immediately followed by a braille glyph (U+2800–U+28FF) or an elapsed-time digit, OR the footer `· esc to interrupt)` inside the live status parens (leading bullet/middot + trailing `)`). Both anchors mirror provider.v1.json tui.spinner so prose can no longer self-match. See claude-cli/specs/4.0.json status_tail.",
  "states": [
    {
      "id": "starting",
      "label": "Starting",
      "initial": true,
      "status": "idle"
    },
    {
      "id": "idle",
      "label": "Ready",
      "status": "idle"
    },
    {
      "id": "busy",
      "label": "Working",
      "status": "generating"
    },
    {
      "id": "mcp_init",
      "label": "Starting MCP",
      "status": "idle"
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
          "flags": "gm",
          "continuation_lines": true,
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "trust",
      "label": "Trust required",
      "modal": true,
      "modal_kind": "approval",
      "extract": {
        "title": {
          "section": "modal",
          "first_line": true
        },
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r",
          "min_count": 2
        }
      }
    },
    {
      "id": "picker",
      "label": "Picker open",
      "modal": true,
      "modal_kind": "picker",
      "extract": {
        "buttons": {
          "section": "modal",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$",
          "flags": "gm",
          "key_for_index": "{index}\r"
        }
      }
    }
  ],
  "transitions": [
    {
      "label": "startup-grace",
      "from": "starting",
      "to": "idle",
      "when": {
        "any": [
          {
            "all": [
              {
                "section": "body",
                "matches": "(?:^|\\n)›\\s"
              },
              {
                "not": {
                  "section": "body",
                  "matches": "Starting MCP servers \\("
                }
              },
              {
                "not": {
                  "section": "status_tail",
                  "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
                }
              },
              {
                "stable_ms": 1500,
                "cursor_above": 4
              }
            ]
          },
          {
            "elapsed_ms": 8000
          }
        ]
      }
    },
    {
      "label": "→trust",
      "from": ["starting", "idle", "busy", "mcp_init"],
      "to": "trust",
      "priority": 110,
      "when": {
        "section": "modal",
        "matches": "Do you trust the contents of this directory\\?"
      }
    },
    {
      "label": "→approval",
      "from": ["starting", "idle", "busy", "mcp_init"],
      "to": "approval",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Would you like to run the following command\\?|Allow command\\?|Allow Codex to|Allow the .+ MCP server to run tool|enter to submit \\| esc to cancel"
      }
    },
    {
      "label": "→picker",
      "from": ["idle", "busy"],
      "to": "picker",
      "priority": 100,
      "when": {
        "section": "modal",
        "matches": "Select a model|switch to a different model"
      }
    },
    {
      "label": "→mcp_init",
      "from": ["starting", "idle"],
      "to": "mcp_init",
      "when": {
        "section": "body",
        "matches": "Starting MCP servers \\("
      }
    },
    {
      "label": "mcp_init→busy",
      "from": "mcp_init",
      "to": "busy",
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
      }
    },
    {
      "label": "mcp_init→idle",
      "from": "mcp_init",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "body",
              "matches": "Starting MCP servers \\("
            }
          },
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
            }
          },
          {
            "stable_ms": 1500,
            "cursor_above": 4
          }
        ]
      }
    },
    {
      "label": "idle→busy",
      "from": "idle",
      "to": "busy",
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
      }
    },
    {
      "label": "busy→idle",
      "from": "busy",
      "to": "idle",
      "min_hold_ms": 500,
      "when": {
        "all": [
          {
            "not": {
              "section": "status_tail",
              "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
            }
          },
          {
            "not": {
              "section": "body",
              "matches": "Starting MCP servers \\("
            }
          },
          {
            "stable_ms": 1500,
            "cursor_above": 4
          }
        ]
      }
    },
    {
      "label": "approval→busy",
      "from": ["approval", "trust", "picker"],
      "to": "busy",
      "when": {
        "section": "status_tail",
        "matches": "(?:(?:^|\\n)[^\\n]*?(?:Working|Thinking)\\s\\((?:[\\u2800-\\u28ff]|\\d))|(?:[·•]\\s*esc to interrupt\\))"
      }
    },
    {
      "label": "approval→idle",
      "from": ["approval", "trust", "picker"],
      "to": "idle",
      "min_hold_ms": 300,
      "when": {
        "all": [
          {
            "not": {
              "section": "modal",
              "matches": "Would you like to run the following command\\?|Allow command\\?|Allow Codex to|Allow the .+ MCP server to run tool|enter to submit \\| esc to cancel"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Do you trust the contents of this directory\\?"
            }
          },
          {
            "not": {
              "section": "modal",
              "matches": "Select a model|switch to a different model"
            }
          },
          {
            "stable_ms": 800,
            "cursor_above": 5
          }
        ]
      }
    }
  ],
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": ["busy", "mcp_init"],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": ["idle"],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select a model|switch to a different model"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r"
      }
    },
    {
      "id": "set_mode",
      "label": "Mode",
      "visible_when_state": ["idle"],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/approvals\r",
        "wait_for": {
          "section": "modal",
          "regex": "Select Approval Mode|Choose what Codex can do|approval mode|Switch approval"
        },
        "extract_choices": {
          "section": "modal",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": ["idle"],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Codex",
      "body": "{state.title}"
    },
    {
      "id": "trust_needed",
      "when_state": "trust",
      "title": "Codex needs to trust this directory",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.codex/sessions/{yyyy}/{mm}/{dd}",
      "file_pattern": "rollout-*.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": {
        "where": "$.type == 'response_item' && $.payload.type == 'message' && !startsWith($.payload.content[0].text, '<environment_context>') || $.type == 'response_item' && $.payload.type == 'function_call' || $.type == 'response_item' && $.payload.type == 'function_call_output' || $.type == 'response_item' && $.payload.type == 'custom_tool_call' || $.type == 'response_item' && $.payload.type == 'custom_tool_call_output'"
      },
      "message_map": {
        "role": "$.payload.role",
        "content": "$.payload.content[0].text",
        "timestamp_ms": "$.timestamp",
        "tools": {
          "block_type": "$.payload.type",
          "call_name": "$.payload.name",
          "call_args": "$.payload.arguments",
          "result_content": "$.payload.output"
        }
      }
    }
  }
}
