{
  "$schema": "adhdev:cli/spec@1",
  "id": "codex-cli",
  "name": "Codex CLI",
  "binary": "codex",
  "cli_version_range": ">=0.137.0",
  "spawn_args": [],
  "send_message": {
    "submit_key": "\r",
    "delay_ms_before_submit": 200
  },
  "debounce": {
    "busy_hold_ms": 8000
  },
  "layout": {
    "sections": [
      {
        "id": "footer",
        "from_bottom": 1
      },
      {
        "id": "modal_zone",
        "from_bottom": 18,
        "until": {
          "section": "footer"
        }
      },
      {
        "id": "body",
        "from_top": 0,
        "until": {
          "section": "modal_zone"
        }
      }
    ]
  },
  "states": [
    {
      "id": "trust",
      "label": "Trust required",
      "when": {
        "section": "modal_zone",
        "regex": "Do you trust the contents of this directory\\?"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Do you trust the contents of this directory\\?)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r"
      }
    },
    {
      "id": "update_banner",
      "label": "Update available",
      "when": {
        "regex": "Update available!"
      },
      "extract_title": {
        "regex": "Update available! ([^\\n]+)"
      },
      "modal_buttons": {
        "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$",
        "key_for_index": "{index}\r"
      }
    },
    {
      "id": "approval",
      "label": "Approval requested",
      "when": {
        "section": "modal_zone",
        "regex": "Allow command\\?|Allow Codex to|Allow the .+ MCP server to run tool|enter to submit \\| esc to cancel"
      },
      "extract_title": {
        "section": "modal_zone",
        "regex": "(Allow command\\?|Allow Codex to [^\\n]+|Allow the [^\\n]+ MCP server to run tool [^\\n]+)"
      },
      "modal_buttons": {
        "section": "modal_zone",
        "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s*(\\S.+?)\\s*$",
        "key_for_index": "{index}\r"
      }
    },
    {
      "id": "busy",
      "label": "Working",
      "when": {
        "section": "footer",
        "regex": "esc to interrupt|Working \\("
      }
    },
    {
      "id": "idle",
      "label": "Ready",
      "when": {
        "section": "footer",
        "regex": "tab to queue message|⏎\\s+send"
      }
    }
  ],
  "default_state": "idle",
  "control_bar": [
    {
      "id": "stop",
      "label": "Stop",
      "visible_when_state": [
        "busy"
      ],
      "action": {
        "type": "send_keys",
        "keys": "\u0003"
      }
    },
    {
      "id": "set_model",
      "label": "Model",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "open_picker",
        "trigger_keys": "/model\r",
        "wait_for": {
          "section": "modal_zone",
          "regex": "Select a model|switch to a different model"
        },
        "extract_choices": {
          "section": "modal_zone",
          "pattern": "^\\s*(?:[›>]\\s*)?(\\d+)\\.\\s+(.+?)\\s*$"
        },
        "submit_key": "{index}\r"
      }
    },
    {
      "id": "attach_image",
      "label": "📎",
      "visible_when_state": [
        "idle"
      ],
      "action": {
        "type": "attach_image",
        "method": "tempfile_then_keys",
        "keys_template": "{path}\r"
      }
    }
  ],
  "notifications": [
    {
      "id": "approval_needed",
      "when_state": "approval",
      "title": "Approval needed in Codex",
      "body": "{state.title}"
    },
    {
      "id": "trust_needed",
      "when_state": "trust",
      "title": "Codex needs to trust this directory",
      "body": "{state.title}"
    }
  ],
  "delegate": [],
  "native_history": {
    "source": {
      "kind": "jsonl",
      "path": "~/.codex/sessions/{yyyy}/{mm}/{dd}",
      "file_pattern": "rollout-*.jsonl",
      "session_id_from": "filename_uuid",
      "message_filter": { "where": "$.type == 'response_item' && $.payload.type == 'message' && !startsWith($.payload.content[0].text, '<environment_context>')" },
      "message_map": {
        "role": "$.payload.role",
        "content": "$.payload.content[0].text",
        "timestamp_ms": "$.timestamp"
      }
    }
  }
}